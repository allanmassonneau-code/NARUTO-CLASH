; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Naruto Clash - Shinobi Arena"
config/version="0.3.0"
config/icon="res://assets/icon/icon.png"
config/windows_native_icon="res://assets/icon/icon.ico"
run/main_scene="res://ui/main/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

DebugSettings="*res://debug/debug_settings.gd"
GameSession="*res://core/match/game_session.gd"
Net="*res://multiplayer/net.gd"
Profiles="*res://core/progression/profiles.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

