[sub_resource type="Resource" id="Resource_l25fc"]
script = ExtResource("2_3fpi1")
id = &"katon_d_braise_tracante"
display_name = "Braise traçante"
description = "Le lanceur souffle un petit noyau incandescent rapide."
source = 0
rank = 0
owner_id = &"katon"
chakra_cost = 12.0
cooldown = 6.0
tags = Array[StringName]([&"RANGED", &"PROJECTILE", &"DEBUFF"])
design_tags = PackedStringArray("Projectile", "Marque", "Poke")
details = "Le lanceur souffle un petit noyau incandescent rapide. À l'impact, les dégâts sont faibles mais une Braise est fixée à la cible pendant quelques secondes. Si le projectile manque, il reste au sol comme une petite Braise de terrain.

Mécanique : Le projectile possède une légère correction de trajectoire uniquement contre une cible déjà visible au moment du lancer ; il ne tourne pas derrière un obstacle. Une cible portant la Braise devient la meilleure amorce du kit : toute future Ignition provoque en plus une micro-explosion autour d'elle.

Synergies : Permet de préparer Comète incendiaire, Prison thermique ou Fournaise solaire. Les Braises au sol peuvent aussi être poussées ou dispersées par certains effets de vent.

Contre-jeu : Le projectile est volontairement peu dangereux seul : esquive latérale, couvert ou purge d'état. La Braise est visible et indique clairement au joueur qu'un combo Katon est en préparation."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_0qsc4"]
script = ExtResource("2_3fpi1")
id = &"katon_d_souffle_de_recul"
display_name = "Souffle de recul"
description = "Après de courts mudras, le lanceur expulse une gerbe très courte devant lui."
source = 0
rank = 0
owner_id = &"katon"
chakra_cost = 12.0
cooldown = 6.0
tags = Array[StringName]([&"AOE"])
design_tags = PackedStringArray("Cône", "Anti-melee", "Zone")
details = "Après de courts mudras, le lanceur expulse une gerbe très courte devant lui. Elle inflige peu de dégâts, repousse fortement les ennemis proches et recouvre le sol d'une bande de Cendres.

Mécanique : Le centre du cône repousse plus loin que les bords. Une cible déjà en train d'attaquer au corps à corps est brièvement déséquilibrée plutôt que simplement déplacée. La bande de Cendres reste quelques secondes et peut être embrasée par une autre technique.

Synergies : Excellent outil de désengagement qui transforme ensuite la distance créée en espace dangereux. Une Braise traçante tirée dans les Cendres peut créer un point d'Ignition à distance.

Contre-jeu : Portée très courte, dégâts modestes et préparation lisible. Un adversaire qui feinte son entrée peut faire partir le sort dans le vide puis engager pendant son cooldown."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_jj361"]
script = ExtResource("2_3fpi1")
id = &"katon_c_anneau_de_cendres"
display_name = "Anneau de cendres"
description = "Le lanceur dessine rapidement un cercle de Cendres autour d'un point ciblé."
source = 0
rank = 1
owner_id = &"katon"
chakra_cost = 20.0
cooldown = 10.0
tags = Array[StringName]([&"AOE", &"CC"])
design_tags = PackedStringArray("Zone", "Piège", "Contrôle")
details = "Le lanceur dessine rapidement un cercle de Cendres autour d'un point ciblé. Le cercle est traversable, mais le premier ennemi qui franchit son bord reçoit une Braise et laisse une traînée de pas incandescents derrière lui.

Mécanique : L'intérieur du cercle n'est pas une prison : la menace vient du bord. Si une Ignition survient sur un porteur de Braise à l'intérieur, le bord du cercle flambe brièvement et repousse vers le centre ceux qui tentent de sortir exactement à ce moment.

Synergies : Crée une vraie situation de duel : enfermer quelqu'un avec Prison thermique, forcer un dash, ou provoquer une mauvaise sortie avec Souffle de recul.

Contre-jeu : Le cercle est visible dès sa création, possède une durée limitée et n'empêche jamais une sortie. Une mobilité bien temporisée traverse avant l'embrasement ; un ennemi peut aussi simplement combattre hors du cercle."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_6l0uo"]
script = ExtResource("2_3fpi1")
id = &"katon_c_comete_incendiaire"
display_name = "Comète incendiaire"
description = "Le joueur charge une boule de feu lourde puis la lance en cloche."
source = 0
rank = 1
owner_id = &"katon"
chakra_cost = 20.0
cooldown = 10.0
tags = Array[StringName]([&"RANGED", &"PROJECTILE", &"LAUNCH", &"CC"])
design_tags = PackedStringArray("Projectile chargé", "Burst", "Recast")
details = "Le joueur charge une boule de feu lourde puis la lance en cloche. Un second appui pendant le vol la fait éclater prématurément en trois fragments plus petits qui continuent dans un éventail.

Mécanique : La boule principale inflige un impact moyen et crée une zone brûlante. Si elle touche une cible portant au moins 2 Braises, elle les consomme pour provoquer une explosion verticale qui projette brièvement la cible vers le haut. Les fragments n'ont pas cette propriété mais couvrent davantage d'espace.

Synergies : Le choix entre projectile lourd et éclatement fait du sort un outil de lecture. Anneau de cendres aide à prédire l'esquive ; Braise traçante débloque le launcher.

Contre-jeu : Charge visible et projectile destructible ou évitable. Faire éclater trop tôt réduit nettement le potentiel mono-cible. Le lanceur est ralenti pendant la charge."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_malrd"]
script = ExtResource("2_3fpi1")
id = &"katon_b_prison_thermique"
display_name = "Prison thermique"
description = "Le lanceur pose un noyau au sol ; après un court délai, une cloche de chaleur semi-transparente apparaît autour de la zone."
source = 0
rank = 2
owner_id = &"katon"
chakra_cost = 28.0
cooldown = 14.0
tags = Array[StringName]([&"AOE", &"CC", &"HEAL", &"DEBUFF"])
design_tags = PackedStringArray("Dôme", "Contrôle", "Anti-heal")
details = "Le lanceur pose un noyau au sol ; après un court délai, une cloche de chaleur semi-transparente apparaît autour de la zone. Les personnages peuvent traverser la paroi, mais chaque traversée applique une Braise et un bref ralentissement.

Mécanique : À l'intérieur, les soins reçus sont légèrement réduits et les Braises expirent moins vite. Si une Ignition consomme 3 Braises dans le dôme, la paroi pulse et repousse tous les ennemis vers l'intérieur une seule fois.

Synergies : Transforme le Katon en contrôleur d'espace sans hard-stun permanent. Anneau de cendres superposé produit plusieurs chemins de sortie coûteux ; Souffle de recul peut renvoyer quelqu'un dans le dôme.

Contre-jeu : Le noyau est destructible avant l'ouverture complète. La prison n'est jamais solide : un adversaire peut payer le coût d'une traversée pour sortir. Le dôme est particulièrement faible si le lanceur ne possède aucune Braise à exploiter."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_x3njr"]
script = ExtResource("2_3fpi1")
id = &"katon_b_lance_de_verre"
display_name = "Lance de verre"
description = "Le lanceur condense un trait de feu extrêmement fin puis le projette en ligne droite."
source = 0
rank = 2
owner_id = &"katon"
chakra_cost = 28.0
cooldown = 14.0
tags = Array[StringName]([&"RANGED", &"PROJECTILE", &"AOE"])
design_tags = PackedStringArray("Skillshot", "Perforation", "Anti-armure")
details = "Le lanceur condense un trait de feu extrêmement fin puis le projette en ligne droite. La première surface de terrain touchée est vitrifiée pendant quelques secondes ; les protections temporaires et boucliers subissent des dégâts supplémentaires.

Mécanique : Contre une cible portant une Braise, la lance la fait éclater sans consommer les autres : elle ouvre ainsi une petite fenêtre de Fracture thermique qui réduit brièvement la résistance au prochain coup, mais ne provoque pas le burst d'une vraie Ignition.

Synergies : C'est le choix B orienté précision : Braise traçante facilite la préparation, puis Lance de verre punit une armure ou un rempart. Très forte avec une équipe qui sait exploiter la courte Fracture.

Contre-jeu : Hitbox étroite, pas d'explosion et télégraphe sonore aigu. Un dash latéral suffit. Le lanceur reste brièvement immobile au moment du tir, ce qui permet le contre-poke."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_8xcet"]
script = ExtResource("2_3fpi1")
id = &"katon_a_mer_de_flammes"
display_name = "Mer de flammes"
description = "Le joueur enflamme une zone de Cendres ou un point de sol."
source = 0
rank = 3
owner_id = &"katon"
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"AOE"])
design_tags = PackedStringArray("Terrain", "Propagation", "Zoning")
details = "Le joueur enflamme une zone de Cendres ou un point de sol. Le feu se propage ensuite lentement vers les zones de Cendres adjacentes et suit les traces de pas incandescentes créées par Anneau de cendres.

Mécanique : La propagation n'est pas instantanée : elle dessine un front de flammes visible. Un ennemi qui reste dans le feu accumule des Braises plus vite mais ne subit pas un stun. Le lanceur peut réactiver une fois la technique pour arrêter la propagation et faire exploser uniquement le bord actuel.

Synergies : Transforme la préparation du terrain des rangs D/C en menace de haut niveau. Le joueur Katon peut construire son propre labyrinthe de propagation plutôt que poser une simple AOE géante.

Contre-jeu : Les zones sans Cendres limitent fortement la portée. Sortir du front avant qu'il arrive est la réponse principale. Les effets qui nettoient ou déplacent les zones au sol cassent la chaîne."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_txv8c"]
script = ExtResource("2_3fpi1")
id = &"katon_a_phenix_a_rebond"
display_name = "Phénix à rebond"
description = "Trois oiseaux de feu sont lancés successivement."
source = 0
rank = 3
owner_id = &"katon"
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"RANGED", &"PROJECTILE"])
design_tags = PackedStringArray("Multi-projectile", "Recast", "Pression")
details = "Trois oiseaux de feu sont lancés successivement. Chaque oiseau qui frappe un mur, un bouclier ou une cible peut rebondir une fois. Après le premier rebond, le joueur peut appuyer à nouveau pour orienter tous les oiseaux encore actifs vers un nouveau point.

Mécanique : Un oiseau qui traverse une Braise au sol l'emporte avec lui. S'il touche ensuite un ennemi, cette Braise est appliquée immédiatement. Deux oiseaux ne peuvent pas infliger leur plein burst au même instant : le système impose un léger espacement de dégâts pour préserver le contre-jeu.

Synergies : Très fort dans les espaces fermés et autour des zones préparées. Le recast permet de convertir un tir de zoning en attaque de flanc.

Contre-jeu : Les oiseaux sont visibles, destructibles par certaines défenses et perdent beaucoup de valeur en terrain ouvert. Le recast ne corrige pas une mauvaise position initiale."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_jgic1"]
script = ExtResource("2_3fpi1")
id = &"katon_s_fournaise_solaire"
display_name = "Fournaise solaire"
description = "Le lanceur canalise brièvement puis tente d'Igniter simultanément toutes ses Braises actives sur ennemis et terrain dans une grande zone."
source = 0
rank = 4
owner_id = &"katon"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"MELEE", &"AOE"])
design_tags = PackedStringArray("Finisher", "Détonation globale", "Risque")
details = "Le lanceur canalise brièvement puis tente d'Igniter simultanément toutes ses Braises actives sur ennemis et terrain dans une grande zone. Chaque point explose séparément ; plus les Braises sont espacées, plus la zone totale couverte est grande.

Mécanique : Une même cible ne peut subir qu'un nombre limité d'explosions directes, mais les détonations peuvent se chevaucher pour créer des corridors dangereux. À 3 Braises sur une cible, l'explosion finale devient une éruption verticale qui interrompt les canalisations.

Synergies : C'est l'aboutissement du gameplay de préparation : un Katon qui a marqué plusieurs personnes et préparé le terrain obtient un S spectaculaire. Utiliser Mer de flammes avant peut forcer des positions idéales.

Contre-jeu : Canalisation très identifiable ; si le lanceur est interrompu avant le flash final, aucune Braise n'est consommée mais le sort passe sur un cooldown partiel. Sans préparation préalable, le S est volontairement médiocre."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_fiina"]
script = ExtResource("2_3fpi1")
id = &"katon_s_dragon_de_feu_devorant"
display_name = "Dragon de feu dévorant"
description = "Le joueur invoque un dragon de feu qu'il dirige pendant quelques secondes avec son viseur."
source = 0
rank = 4
owner_id = &"katon"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"BUFF"])
design_tags = PackedStringArray("Invocation dirigée", "Absorption", "Recast")
details = "Le joueur invoque un dragon de feu qu'il dirige pendant quelques secondes avec son viseur. Le dragon avance continuellement, inflige des dégâts sur contact et peut avaler les petits projectiles non ultimes qu'il rencontre.

Mécanique : Chaque projectile avalé augmente une jauge de Gueule ardente. Le joueur peut réactiver pour faire plonger le dragon sur une zone ; la taille de l'explosion dépend de la jauge. Avaler une Braise de terrain compte comme une petite charge et permet de courber légèrement la trajectoire.

Synergies : S orienté maîtrise mécanique et anti-zoning. Il peut protéger une avancée alliée, nettoyer une salve de projectiles puis convertir cette défense en attaque.

Contre-jeu : Pendant le contrôle, le lanceur se déplace lentement et reste vulnérable. Les attaques de mêlée, rayons lourds et ultimes ne sont pas avalés. Le dragon possède une durée maximale stricte."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_u1518"]
script = ExtResource("4_xgouj")
id = &"katon"
display_name = "Katon"
description = "Feu : dégâts en zone et brûlures."
identity = "Katon est la nature de la pression et de l'escalade. Ses techniques créent des Braises et des zones de Cendres. Les Braises sont des marqueurs temporaires posés sur les ennemis ou le terrain ; certaines techniques les allument pour produire un second effet. Le Katon récompense donc la préparation, l'enfermement d'une cible et la lecture de ses chemins de fuite plutôt que le simple spam de projectiles."
signature = "Braise / Ignition : une cible peut porter jusqu'à 3 Braises. Une Ignition consomme toutes les Braises et améliore son effet selon le nombre consommé. Les zones de Cendres n'infligent presque rien seules, mais servent de combustible à plusieurs techniques."
color = Color(1, 0.478431, 0.101961, 1)
jutsu = Array[ExtResource("2_3fpi1")]([SubResource("Resource_l25fc"), SubResource("Resource_0qsc4"), SubResource("Resource_jj361"), SubResource("Resource_6l0uo"), SubResource("Resource_malrd"), SubResource("Resource_x3njr"), SubResource("Resource_8xcet"), SubResource("Resource_txv8c"), SubResource("Resource_jgic1"), SubResource("Resource_fiina")])
