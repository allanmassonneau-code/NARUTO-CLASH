details = "Le grand shuriken se sépare en quatre lames après une distance choisie par recast. Chaque lame cherche l'Ancre la plus proche de son angle et peut y ricocher une fois.

Mécanique : Sans Ancre, les lames partent simplement en éventail. Avec un réseau préparé, elles peuvent converger depuis plusieurs directions.

Synergies : Récompense directement la construction géométrique des rangs D/C.

Contre-jeu : Les ancres révèlent les futurs angles possibles ; détruire le réseau avant le cast rend la technique beaucoup plus simple."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_bcury"]
script = ExtResource("2_3fpi1")
id = &"clan_fuma_a_course_sur_cable"
display_name = "Course sur câble"
description = "Pendant quelques secondes, le Fûma peut se verrouiller sur ses câbles et glisser à grande vitesse d'une Ancre à une autre."
source = 1
rank = 3
owner_id = &"clan_fuma"
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"AOE", &"MOVEMENT", &"DASH"])
design_tags = PackedStringArray("Mobilité réseau", "Attaque en mouvement", "Skill expression")
details = "Pendant quelques secondes, le Fûma peut se verrouiller sur ses câbles et glisser à grande vitesse d'une Ancre à une autre. Pendant le trajet, il peut lancer des armes légères sans interrompre le mouvement.

Mécanique : Changer de câble conserve l'élan mais chaque transition consomme l'Ancre quittée.

Synergies : Transforme le réseau préparé en parcours de mobilité spectaculaire et offensif.

Contre-jeu : Préparation obligatoire, trajectoires connues à l'avance, aucun passage à travers les obstacles et vulnérabilité aux AOE placées sur les Ancres."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_ns2wb"]
script = ExtResource("2_3fpi1")
id = &"clan_fuma_s_toile_des_lames_cardinales"
display_name = "Toile des lames cardinales"
description = "Le Fûma plante automatiquement quatre grandes Ancres autour d'une zone et relie toutes les Ancres existantes en une toile temporaire."
source = 1
rank = 4
owner_id = &"clan_fuma"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"RANGED", &"HITSCAN", &"AOE"])
design_tags = PackedStringArray("Réseau total", "Lignes létales", "Recast")
details = "Le Fûma plante automatiquement quatre grandes Ancres autour d'une zone et relie toutes les Ancres existantes en une toile temporaire. À chaque recast, un grand shuriken circule sur un segment choisi par le viseur.

Mécanique : Le projectile accélère à chaque changement de segment, mais ne peut pas repasser immédiatement sur le même. Les ennemis peuvent casser les Ancres pour supprimer des routes.

Synergies : Ultime entièrement basé sur la géométrie, capable de transformer la zone en puzzle de trajectoires.

Contre-jeu : Aucune frappe automatique : le joueur doit choisir les segments. Détruire deux ou trois Ancres réduit énormément le potentiel."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_nm7f5"]
