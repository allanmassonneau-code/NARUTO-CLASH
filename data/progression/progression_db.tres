rank = 1
owner_id = &"raiton"
chakra_cost = 20.0
cooldown = 10.0
tags = Array[StringName]([&"COUNTER"])
design_tags = PackedStringArray("Parade", "Stockage", "Recast")
details = "Le lanceur prend une garde électrique très courte. Si une attaque directe le touche pendant la fenêtre, une partie des dégâts est réduite et l'énergie est stockée dans un Condensateur.

Mécanique : Un second appui libère le Condensateur sous forme d'onde courte. Plus l'attaque absorbée était lourde, plus l'onde repousse ; les dégâts restent plafonnés pour éviter de retourner un ultime intégralement.

Synergies : Donne au Raiton un vrai outil de lecture défensive, puis convertit une bonne parade en setup offensif.

Contre-jeu : Fenêtre courte et directionnelle. Les dégâts persistants, pièges au sol et attaques venant de dos ne déclenchent pas correctement la garde."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_83og0"]
script = ExtResource("2_3fpi1")
id = &"raiton_b_lance_magnetique"
display_name = "Lance magnétique"
description = "Une lance d'électricité magnétisée part en ligne et s'accroche au premier ennemi touché."
