[sub_resource type="Resource" id="Resource_a4765"]
script = ExtResource("2_3fpi1")
id = &"suiton_a_miroir_liquide"
display_name = "Miroir liquide"
description = "Le lanceur crée devant lui un disque d'eau pendant une très courte fenêtre."
