passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_ukrwp"]
script = ExtResource("2_3fpi1")
id = &"raiton_a_tonnerre_guide"
display_name = "Tonnerre guidé"
description = "Le lanceur désigne une cible visible."
