[sub_resource type="Resource" id="Resource_qhjy6"]
script = ExtResource("2_3fpi1")
id = &"clan_hoshigaki_s_grand_requin_devoreur_de_chakra"
display_name = "Grand requin dévoreur de chakra"
description = "Un énorme requin d'eau avance lentement."
source = 1
rank = 4
owner_id = &"clan_hoshigaki"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"RANGED", &"PROJECTILE"])
