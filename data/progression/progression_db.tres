[sub_resource type="Resource" id="Resource_fetnm"]
script = ExtResource("2_3fpi1")
id = &"clan_roran_s_theatre_des_mille_vents"
display_name = "Théâtre des mille vents"
description = "Le Roran plante son grand éventail et crée un domaine circulaire où quatre directions de vent sont matérialisées."
source = 1
rank = 4
owner_id = &"clan_roran"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"AOE", &"MELEE"])
design_tags = PackedStringArray("Domaine", "Stances", "Commandes séquencées")
details = "Le Roran plante son grand éventail et crée un domaine circulaire où quatre directions de vent sont matérialisées. À intervalles courts, il peut choisir l'une d'elles et déclencher soit une poussée, soit une aspiration selon sa Posture.

Mécanique : Chaque Battement disponible au lancement ajoute une commande gratuite supplémentaire. Les ennemis voient la direction choisie une fraction de seconde avant l'impulsion.

Synergies : Ultime de chef d'orchestre : contrôle du spacing, protection d'alliés, mise en ligne pour des skillshots, sans hard-stun automatique.

Contre-jeu : Domaine fixe, éventail central destructible et télégraphes visibles. Une équipe qui se disperse réduit la valeur des impulsions."
requirements = Array[StringName]([])
passive = false
