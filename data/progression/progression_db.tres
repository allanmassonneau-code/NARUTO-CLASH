details = "Un éclair frappe une cible ou un point chargé puis cherche jusqu'à deux nouvelles cibles proches. Chaque saut inflige moins de dégâts mais transporte 1 Charge.

Mécanique : Le joueur peut viser le sol chargé pour lancer la chaîne depuis un angle inattendu. Une même cible ne peut être frappée qu'une fois par cast.

Synergies : Excellent pour répandre les Charges dans un groupe avant Cage de foudre ou Cataclysme.

Contre-jeu : Faible valeur contre une cible isolée et portée de saut visible. Écarter la formation réduit fortement l'effet."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_u8xly"]
script = ExtResource("2_3fpi1")
id = &"raiton_c_garde_statique"
display_name = "Garde statique"
description = "Le lanceur prend une garde électrique très courte."
