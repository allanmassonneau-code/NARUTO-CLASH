signature = "Calories : jauge dédiée remplie progressivement hors des grosses dépenses et par certaines actions. Les techniques consomment des quantités différentes. À Calories basses, le personnage n'est pas affaibli en permanence, mais ses techniques avancées perdent certaines variantes."
jutsu = Array[ExtResource("2_3fpi1")]([SubResource("Resource_rw7jj"), SubResource("Resource_3jqkh"), SubResource("Resource_xli6g"), SubResource("Resource_rls28"), SubResource("Resource_ov1q0")])
