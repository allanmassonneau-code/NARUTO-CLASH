[sub_resource type="Resource" id="Resource_6axol"]
script = ExtResource("7_tkkme")
weight = 4.0
exclusions = Array[StringName]([])
allowed_villages = Array[StringName]([])
rollable = true
id = &"sub_b_shunshin_double_empreinte"
display_name = "Shunshin — Double empreinte"
description = "Le joueur marque discrètement son point de départ puis effectue un déplacement éclair court dans la direction visée."
source = 3
rank = 2
owner_id = &""
chakra_cost = 28.0
cooldown = 14.0
tags = Array[StringName]([&"MOVEMENT", &"DASH"])
design_tags = PackedStringArray("Mobilité", "Recast", "Feinte")
details = "Le joueur marque discrètement son point de départ puis effectue un déplacement éclair court dans la direction visée. Pendant une seconde, il peut réactiver pour revenir exactement sur l'empreinte initiale.

Mécanique : Le retour conserve l'orientation actuelle, ce qui permet de feinter un engage, traverser une ligne de menace ou forcer une réaction avant de revenir. L'empreinte ne peut pas être placée en l'air ou derrière un mur non franchi.

Synergies : Sub-jutsu universel à forte expression mécanique : sa puissance vient du timing du recast, pas d'une invulnérabilité longue.

Contre-jeu : L'empreinte est brièvement visible au sol. Les dégâts et contrôles reçus ne sont pas annulés par le retour ; un adversaire peut piéger le point de départ."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_s0v5b"]
script = ExtResource("7_tkkme")
weight = 4.0
exclusions = Array[StringName]([])
allowed_villages = Array[StringName]([])
rollable = true
id = &"sub_b_clone_explosif_tactique"
display_name = "Clone explosif tactique"
description = "Un clone part dans une direction et reproduit les déplacements simples du joueur avec un léger retard pendant quelques secondes."
source = 3
rank = 2
owner_id = &""
chakra_cost = 28.0
cooldown = 14.0
tags = Array[StringName]([&"AOE", &"BUFF"])
design_tags = PackedStringArray("Decoy", "Recast", "Piège")
details = "Un clone part dans une direction et reproduit les déplacements simples du joueur avec un léger retard pendant quelques secondes. Il n'attaque pas réellement.

Mécanique : Le joueur peut le faire exploser manuellement ; s'il est détruit par un ennemi, il explose plus faiblement. L'explosion repousse et pose une marque sonore, mais ses dégâts restent modérés.

Synergies : Permet de casser un lock, contrôler un angle ou préparer une attaque depuis le côté opposé.

Contre-jeu : Le clone possède des mouvements légèrement artificiels et un seul point de vie. L'ignorer est souvent la meilleure réponse."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_s6c4o"]
script = ExtResource("7_tkkme")
weight = 4.0
exclusions = Array[StringName]([])
allowed_villages = Array[StringName]([])
rollable = true
id = &"sub_b_paume_d_absorption_de_chakra"
display_name = "Paume d'absorption de chakra"
description = "Le joueur ouvre une courte fenêtre de garde dans la paume."
source = 3
rank = 2
owner_id = &""
chakra_cost = 28.0
cooldown = 14.0
tags = Array[StringName]([&"COUNTER"])
design_tags = PackedStringArray("Parade", "Ressource", "Anti-jutsu")
details = "Le joueur ouvre une courte fenêtre de garde dans la paume. Le premier projectile ou impact de chakra compatible touchant le cône frontal est partiellement absorbé.

Mécanique : Une portion plafonnée du coût estimé est rendue en chakra au joueur ; l'attaque n'est jamais totalement annulée si elle est lourde. Réussir l'absorption réduit brièvement le coût du prochain mudra.

Synergies : Récompense une parade précise et peut retourner le tempo d'un duel de ressources.

Contre-jeu : Fenêtre courte, directionnelle, inefficace contre attaques physiques, zones persistantes et ultimes."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_1g8un"]
script = ExtResource("7_tkkme")
weight = 4.0
exclusions = Array[StringName]([])
allowed_villages = Array[StringName]([])
rollable = true
id = &"sub_b_voile_de_brume_silencieuse"
display_name = "Voile de brume silencieuse"
description = "Une brume dense apparaît autour d'un point."
source = 3
rank = 2
owner_id = &""
chakra_cost = 28.0
cooldown = 14.0
tags = Array[StringName]([&"AOE", &"DEBUFF"])
design_tags = PackedStringArray("Zone", "Vision", "Son")
details = "Une brume dense apparaît autour d'un point. À l'intérieur, la vision à moyenne distance est réduite et les noms/indicateurs de cible s'effacent au-delà d'une courte portée.

Mécanique : Le lanceur ne voit pas parfaitement non plus, mais les pas rapides créent pour lui de brefs anneaux sonores au sol. Rester immobile ou marcher lentement minimise ces indices.

Synergies : Crée un minijeu de chasse et de son, utile à de nombreux builds sans remplacer les capacités de Traqueur.

Contre-jeu : Zone fixe, silhouettes visibles à courte portée et attaques révélant toujours leur origine."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_s06py"]
script = ExtResource("7_tkkme")
weight = 4.0
exclusions = Array[StringName]([])
allowed_villages = Array[StringName]([])
rollable = true
id = &"sub_b_reseau_de_parchemins_explosifs"
display_name = "Réseau de parchemins explosifs"
description = "Le joueur peut poser jusqu'à trois parchemins sur surfaces valides."
source = 3
rank = 2
owner_id = &""
chakra_cost = 28.0
cooldown = 14.0
tags = Array[StringName]([&"AOE", &"CC"])
design_tags = PackedStringArray("Piège", "Chaîne", "Programmation")
details = "Le joueur peut poser jusqu'à trois parchemins sur surfaces valides. Réactiver fait exploser celui qui est le plus proche du viseur ; une explosion qui touche la zone d'un autre parchemin le déclenche après un petit délai.

Mécanique : La chaîne suit donc réellement la géométrie du placement. Le joueur peut espacer les explosions pour fermer une route plutôt que tout faire partir simultanément.

Synergies : Sub-jutsu de préparation et de zoning très lisible.

Contre-jeu : Parchemins visibles de près, destructibles et temps de pose vulnérable."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_hdu23"]
