cooldown = 20.0
tags = Array[StringName]([&"AOE", &"CC"])
design_tags = PackedStringArray("Grande zone", "Courant", "Contrôle")
details = "Une zone circulaire se remplit progressivement d'une faible hauteur d'eau. À l'intérieur, le lanceur choisit périodiquement une direction de courant ; tous les personnages sont lentement entraînés dans ce sens.

Mécanique : Les ennemis Trempés subissent davantage le courant, tandis que le lanceur et ses alliés conservent plus de contrôle. Les dashes fonctionnent normalement et permettent de lutter contre le flux.

Synergies : C'est un contrôle spatial souple : il ne bloque pas, mais transforme toutes les trajectoires et facilite les skillshots ou les sorties ratées.

Contre-jeu : Montée de l'eau annoncée, zone fixe et aucun burst initial. Quitter la zone est toujours possible avec une bonne mobilité."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_ybfwg"]
script = ExtResource("2_3fpi1")
id = &"suiton_s_leviathan_de_pression"
display_name = "Léviathan de pression"
description = "Un serpent d'eau massif naît au point ciblé et suit une trajectoire dirigée par le viseur pendant quelques secondes."
source = 0
rank = 4
owner_id = &"suiton"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"CC", &"BUFF"])
design_tags = PackedStringArray("Invocation dirigée", "Capture", "Recast")
details = "Un serpent d'eau massif naît au point ciblé et suit une trajectoire dirigée par le viseur pendant quelques secondes. Les ennemis frappés sont emportés brièvement dans son corps puis relâchés derrière lui.

Mécanique : Le joueur peut réactiver pour faire plonger le Léviathan et exploser en geyser. Plus il a transporté de cibles ou traversé de surfaces d'Eau, plus le geyser est large, sans augmenter indéfiniment les dégâts.

Synergies : S spectaculaire de déplacement d'équipe : il peut séparer une frontline, sauver un allié en emportant ses poursuivants ou préparer une zone de burst.

Contre-jeu : Le Léviathan tourne avec inertie, ne traverse pas les gros murs et le lanceur est ralenti pendant la conduite. Les cibles ne sont transportées qu'un temps limité."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_pt4h4"]
script = ExtResource("2_3fpi1")
id = &"suiton_s_domaine_des_profondeurs"
display_name = "Domaine des profondeurs"
description = "Le lanceur inonde une vaste zone d'une nappe sombre."
source = 0
rank = 4
owner_id = &"suiton"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"AOE", &"MOVEMENT", &"DASH", &"DEBUFF"])
design_tags = PackedStringArray("Domaine", "Mobilité", "Vision")
details = "Le lanceur inonde une vaste zone d'une nappe sombre. Tous les personnages à l'intérieur sont considérés Trempés. Les bruits de déplacement génèrent des ondulations visibles pour le lanceur, tandis que les contours au-delà d'une certaine distance deviennent moins nets pour tout le monde.

Mécanique : Le Suiton peut utiliser Pas de surface sans consommer son recast bonus dans le domaine, mais seulement à intervalles espacés. Les ennemis peuvent volontairement rester immobiles pour ne pas produire d'ondulation, créant un jeu de chasse.

Synergies : Ultime de contrôle de l'information et de mobilité, pas une simple AOE de dégâts. Idéal pour isoler les duels et exploiter les tirs précis.

Contre-jeu : Le domaine est fixe, ne rend personne invisible et les attaques révèlent immédiatement leur origine. Quitter la zone annule ses avantages."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_42a8h"]
script = ExtResource("4_xgouj")
id = &"suiton"
display_name = "Suiton"
description = "Eau : contrôle, ralentissements et prisons."
identity = "Suiton contrôle les trajectoires et le tempo. Il crée des surfaces d'Eau et applique l'état Trempé. Le joueur ne cherche pas seulement à ralentir : il utilise l'eau comme infrastructure de combat, pour modifier ses déplacements, déplacer les ennemis et changer l'angle de ses techniques."
signature = "Trempé / Eau : Trempé n'est pas un debuff massif à lui seul. Il sert de condition à plusieurs effets et reste lisible. Les surfaces d'Eau persistent quelques secondes ; le lanceur Suiton peut glisser dessus plus vite et certaines techniques changent de forme lorsqu'elles les traversent."
