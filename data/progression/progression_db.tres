[sub_resource type="Resource" id="Resource_1v8xb"]
script = ExtResource("1_2nrr7")
id = &"clan_hoshigaki"
display_name = "Hoshigaki"
village_id = &"kiri"
description = "Hommes-requins."
identity = "Le clan Hoshigaki est un prédateur de chakra. Il devient plus dangereux lorsqu'il reste au contact d'ennemis Trempés ou à faible chakra, mais ne vole jamais gratuitement des ressources. Sa jauge de Faim se construit par pression agressive et peut être dépensée pour renforcer les techniques aquatiques bestiales."
signature = "Faim : jusqu'à 3 charges gagnées en infligeant des dégâts significatifs à une cible Trempée, en interrompant un jutsu ou en frappant une cible sous un seuil de chakra. Les charges expirent hors combat et sont consommées par les techniques avancées."
jutsu = Array[ExtResource("2_3fpi1")]([SubResource("Resource_ygngu"), SubResource("Resource_gpjf2"), SubResource("Resource_ycsya"), SubResource("Resource_bl5os"), SubResource("Resource_qhjy6")])
placeholder = false

[sub_resource type="Resource" id="Resource_ga6kq"]
script = ExtResource("2_3fpi1")
id = &"clan_yuki_d_senbon_de_givre"
display_name = "Senbon de givre"
description = "Le Yuki lance une aiguille de glace rapide qui applique 1 Givre."
source = 1
rank = 0
owner_id = &"clan_yuki"
chakra_cost = 12.0
cooldown = 6.0
tags = Array[StringName]([&"RANGED", &"PROJECTILE"])
design_tags = PackedStringArray("Projectile rapide", "Stack", "Poke")
details = "Le Yuki lance une aiguille de glace rapide qui applique 1 Givre. Si elle frappe un mur, elle crée un minuscule éclat réfléchissant qui indique un futur angle de Miroir sans en être un véritable.

Mécanique : Toucher une cible déjà à 4 stacks consomme le seuil et la ralentit fortement un très court instant plutôt que de l'immobiliser totalement.

Synergies : Setup précis et lisible pour toute la progression.

Contre-jeu : Faible dégâts, projectile fin et Givre expirant si le Yuki n'entretient pas la pression."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_ug8rd"]
script = ExtResource("2_3fpi1")
id = &"clan_yuki_c_miroir_de_glace"
display_name = "Miroir de glace"
description = "Le Yuki place un Miroir sur une surface valide."
source = 1
rank = 1
owner_id = &"clan_yuki"
chakra_cost = 20.0
cooldown = 10.0
tags = Array[StringName]([&"MOVEMENT", &"DASH"])
design_tags = PackedStringArray("Objet", "Téléportation", "Angle")
details = "Le Yuki place un Miroir sur une surface valide. Jusqu'à deux peuvent exister. Appuyer à nouveau près d'un Miroir téléporte le joueur vers l'autre avec un bref délai de matérialisation.

Mécanique : Les petits projectiles Yuki qui frappent un Miroir ressortent une fois de l'autre avec une légère perte de vitesse.

Synergies : Crée un réseau simple mais profond de mobilité et d'angles de tir.

Contre-jeu : Miroirs visibles, destructibles et téléportation impossible si la sortie est obstruée. Le délai de sortie est exploitable."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_8dhbk"]
script = ExtResource("2_3fpi1")
id = &"clan_yuki_b_patinoire_fracturee"
display_name = "Patinoire fracturée"
description = "Une longue plaque de glace apparaît au sol."
source = 1
rank = 2
owner_id = &"clan_yuki"
chakra_cost = 28.0
cooldown = 14.0
tags = Array[StringName]([&"AOE"])
design_tags = PackedStringArray("Terrain", "Glisse", "Fissures")
details = "Une longue plaque de glace apparaît au sol. Tous les personnages glissent davantage dessus. Chaque dash ou impact lourd crée une Fissure ; après trois Fissures, la plaque éclate et projette des fragments.

Mécanique : Le Yuki peut volontairement déclencher l'éclatement avec un Senbon dans une Fissure, créant un timing contrôlé.

Synergies : Terrain interactif dont les deux équipes peuvent profiter ou souffrir.

Contre-jeu : Zone visible et neutre : un ennemi habile peut utiliser la glisse à son avantage. L'éclatement est annoncé par l'état de la glace."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_1t3ke"]
script = ExtResource("2_3fpi1")
id = &"clan_yuki_a_labyrinthe_des_miroirs"
display_name = "Labyrinthe des miroirs"
description = "Quatre Miroirs temporaires apparaissent autour d'une zone."
source = 1
rank = 3
owner_id = &"clan_yuki"
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"MOVEMENT", &"DASH", &"DEBUFF"])
design_tags = PackedStringArray("Multi-objet", "Téléportation séquencée", "Illusion légère")
details = "Quatre Miroirs temporaires apparaissent autour d'une zone. Le Yuki peut se déplacer instantanément entre deux Miroirs adjacents à intervalles courts. Chaque déplacement laisse une silhouette de glace qui continue un pas avant de se briser.

Mécanique : Les projectiles de Senbon peuvent traverser au maximum deux Miroirs pendant le labyrinthe, permettant des angles complexes.

Synergies : Kit de duel spatial à haut skill-cap, fondé sur un réseau destructible.

Contre-jeu : Les Miroirs peuvent être détruits, les routes sont limitées aux adjacences et les silhouettes ne masquent pas les effets sonores réels."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_vifr4"]
script = ExtResource("2_3fpi1")
id = &"clan_yuki_s_zero_absolu_cercueil_cristallin"
display_name = "Zéro absolu — Cercueil cristallin"
description = "Une tempête de glace entoure une grande zone et applique progressivement Givre à tous, Yuki compris plus lentement."
source = 1
rank = 4
owner_id = &"clan_yuki"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"AOE", &"MELEE"])
design_tags = PackedStringArray("Domaine froid", "Gestion de stacks", "Finisher")
details = "Une tempête de glace entoure une grande zone et applique progressivement Givre à tous, Yuki compris plus lentement. Les Miroirs présents se renforcent et deviennent temporairement plus difficiles à détruire.

Mécanique : Quand une cible atteint 4 Givres dans le domaine, le Yuki peut consommer le seuil pour faire surgir autour d'elle trois plaques de glace qui se referment après un délai. La cible peut encore sortir avant fermeture ou casser une plaque.

Synergies : Ultime qui transforme la gestion des stacks en menace de capture sans prison instantanée.

Contre-jeu : Montée lente, domaine fixe, plaques destructibles et possibilité claire de quitter la zone avant accumulation maximale."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_nodhp"]
script = ExtResource("1_2nrr7")
id = &"clan_yuki"
display_name = "Yuki"
village_id = &"kiri"
description = "Hyōton : la glace."
identity = "Le clan Yuki joue avec le Froid et des Miroirs de glace. Les stacks de Givre réduisent progressivement l'adhérence et la précision des mouvements sans hard-stun immédiat. Les Miroirs sont des points de téléportation et de réflexion, ce qui crée un kit de mobilité géométrique."
signature = "Givre : maximum 4 stacks. Chaque stack augmente légèrement la glisse après un changement brusque de direction. À 4 stacks, la prochaine technique Yuki qui touche peut déclencher Gel bref puis remet le compteur à zéro. Les Miroirs sont destructibles et limités en nombre."
jutsu = Array[ExtResource("2_3fpi1")]([SubResource("Resource_ga6kq"), SubResource("Resource_ug8rd"), SubResource("Resource_8dhbk"), SubResource("Resource_1t3ke"), SubResource("Resource_vifr4")])
placeholder = false

[sub_resource type="Resource" id="Resource_wt854"]
script = ExtResource("2_3fpi1")
id = &"clan_karatachi_d_epine_de_corail"
display_name = "Épine de corail"
description = "Une pointe de corail est tirée en ligne."
source = 1
rank = 0
owner_id = &"clan_karatachi"
chakra_cost = 12.0
cooldown = 6.0
tags = Array[StringName]([&"RANGED", &"PROJECTILE", &"AOE"])
design_tags = PackedStringArray("Projectile", "Node", "Terrain")
details = "Une pointe de corail est tirée en ligne. Sur terrain, elle crée un Nœud. Sur ennemi, elle s'accroche brièvement comme Nœud mobile et inflige de faibles dégâts.

Mécanique : Le Nœud ennemi tombe au sol s'il expire, donnant encore une petite valeur de terrain.

Synergies : Moteur de construction du réseau.

Contre-jeu : Projectile visible, dégâts faibles et nombre maximum strict de Nœuds."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_rnykl"]
script = ExtResource("2_3fpi1")
id = &"clan_karatachi_c_ecaille_recifale"
display_name = "Écaille récifale"
description = "Une plaque de corail pousse sur un côté du corps choisi au cast."
source = 1
rank = 1
owner_id = &"clan_karatachi"
chakra_cost = 20.0
cooldown = 10.0
tags = Array[StringName]([&"AOE", &"COUNTER", &"DEFENSIVE"])
design_tags = PackedStringArray("Bouclier local", "Riposte", "Node")
details = "Une plaque de corail pousse sur un côté du corps choisi au cast. Elle absorbe une portion d'un impact venant de cet angle puis éclate en deux petits Nœuds sur le sol.

Mécanique : Si elle n'est pas brisée, le joueur peut la détacher volontairement et la planter comme grand Nœud.

Synergies : Défense directionnelle qui alimente ensuite le terrain.

Contre-jeu : Un seul côté protégé, contournable par les angles et AOE."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_8c50s"]
script = ExtResource("2_3fpi1")
id = &"clan_karatachi_b_crete_jaillissante"
display_name = "Crête jaillissante"
description = "Le Karatachi choisit deux Nœuds."
source = 1
rank = 2
owner_id = &"clan_karatachi"
chakra_cost = 28.0
cooldown = 14.0
tags = Array[StringName]([&"RANGED", &"HITSCAN", &"AOE", &"LAUNCH", &"CC"])
design_tags = PackedStringArray("Ligne entre nodes", "Terrain", "Launcher")
details = "Le Karatachi choisit deux Nœuds. Une crête de corail pousse progressivement entre eux. Les ennemis au-dessus sont légèrement soulevés et déplacés vers le côté le plus proche.

Mécanique : La crête reste comme obstacle bas destructible. Un Nœud attaché à un ennemi peut servir de point mobile, mais la croissance s'arrête si la distance devient trop grande.

Synergies : Permet des murs dynamiques et des trajectoires inattendues, surtout avec un Nœud mobile.

Contre-jeu : Préparation nécessaire, croissance visible et structures cassables."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_aim3i"]
script = ExtResource("2_3fpi1")
id = &"clan_karatachi_a_recif_predateur"
display_name = "Récif prédateur"
description = "Tous les Nœuds actifs commencent à pousser lentement vers le Nœud voisin le plus proche."
source = 1
rank = 3
owner_id = &"clan_karatachi"
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"AOE"])
design_tags = PackedStringArray("Réseau", "Propagation", "Piège progressif")
details = "Tous les Nœuds actifs commencent à pousser lentement vers le Nœud voisin le plus proche. Lorsque deux pousses se rencontrent, elles créent une bouche de corail qui se ferme une fois sur le premier ennemi qui la traverse, provoquant une brève saisie des jambes.

Mécanique : Après fermeture, la bouche devient simple obstacle. Le joueur peut donc transformer son réseau en une série de pièges à usage unique.

Synergies : Récompense énormément la préparation des rangs précédents et la lecture des chemins.

Contre-jeu : Les lignes de pousse sont visibles et lentes. Détruire un Nœud avant connexion casse toute une branche."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_j4hb2"]
script = ExtResource("2_3fpi1")
id = &"clan_karatachi_s_sanctuaire_de_la_tortue_corallienne"
display_name = "Sanctuaire de la tortue corallienne"
description = "Le Karatachi fait croître une grande carapace de corail autour de ses Nœuds existants."
source = 1
rank = 4
owner_id = &"clan_karatachi"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"AOE", &"DEFENSIVE"])
design_tags = PackedStringArray("Forteresse réseau", "Bouclier partagé", "Recast")
details = "Le Karatachi fait croître une grande carapace de corail autour de ses Nœuds existants. Chaque Nœud devient un pilier relié aux autres ; les alliés proches d'un pilier reçoivent un petit bouclier partagé avec celui-ci.

Mécanique : Réactiver fait éclater les piliers restants vers l'extérieur en éventails de fragments ; plus on conserve de piliers défensifs, plus le final couvre d'angles, mais la forteresse disparaît.

Synergies : Ultime à bascule défense/offense basé sur l'état réel du réseau.

Contre-jeu : Très dépendant des Nœuds préalables. Les piliers peuvent être focus et l'explosion finale est annoncée par une vibration du récif."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_fw6gw"]
script = ExtResource("1_2nrr7")
id = &"clan_karatachi"
display_name = "Karatachi"
village_id = &"kiri"
description = "Corail et miroirs d'eau."
identity = "Proposition d'identité pour Karatachi : chakra de corail, carapace et récif. Le kit crée des Nœuds de corail sur les surfaces et les personnages, puis les fait pousser en structures défensives ou offensives. Cela donne à Kiri un contrôleur de terrain minéral très différent du Doton : le corail se propage par réseau plutôt que par masse brute."
signature = "Calcification : les techniques posent des Nœuds de corail, maximum 5. Deux Nœuds proches peuvent se relier par une Crête. Les Nœuds sur ennemi ne bloquent pas ses mouvements mais rendent certaines poussées de corail plus faciles à orienter. Les structures sont cassables."
jutsu = Array[ExtResource("2_3fpi1")]([SubResource("Resource_wt854"), SubResource("Resource_rnykl"), SubResource("Resource_8c50s"), SubResource("Resource_aim3i"), SubResource("Resource_j4hb2")])
placeholder = false

[sub_resource type="Resource" id="Resource_87s5h"]
script = ExtResource("2_3fpi1")
id = &"clan_epeistes_d_iai_de_garde"
display_name = "Iai de garde"
description = "L'Épéiste rengaine brièvement puis dégaine dans un arc."
source = 1
rank = 0
owner_id = &"clan_epeistes"
chakra_cost = 12.0
cooldown = 6.0
tags = Array[StringName]([&"COUNTER"])
design_tags = PackedStringArray("Parade", "Draw attack", "Ressource")
details = "L'Épéiste rengaine brièvement puis dégaine dans un arc. Si une attaque de mêlée entre pendant la fenêtre initiale, elle est parée et le coup sort plus vite, générant 1 Fil.

Mécanique : Sans parade, l'attaque reste une coupe normale mais plus lente.

Synergies : Apprend immédiatement le rythme défensif/offensif du kit.

Contre-jeu : Fenêtre de parade courte, aucune protection contre la distance ou les AOE et récupération longue si le coup whiff."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_dx1yj"]
script = ExtResource("2_3fpi1")
id = &"clan_epeistes_c_lame_en_rappel"
display_name = "Lame en rappel"
description = "L'Épéiste lance son arme en rotation."
source = 1
rank = 1
owner_id = &"clan_epeistes"
chakra_cost = 20.0
cooldown = 10.0
tags = Array[StringName]([&"RANGED", &"PROJECTILE"])
design_tags = PackedStringArray("Throw", "Retrieval", "Positioning")
details = "L'Épéiste lance son arme en rotation. Elle se plante dans une surface ou tombe après impact. Tant qu'elle est au sol, le joueur combat avec une garde réduite mais peut réactiver pour rappeler l'arme en ligne droite.

Mécanique : Toucher une cible avec le retour génère 1 Fil. Dépenser 1 Fil permet au joueur de faire un petit pas vers l'arme au moment du rappel, réduisant la distance.

Synergies : Crée un axe dangereux aller/retour et une vraie période de vulnérabilité sans arme.

Contre-jeu : Trajectoire de retour prévisible ; un adversaire peut se placer hors ligne et profiter de la garde réduite."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_p1niu"]
script = ExtResource("2_3fpi1")
id = &"clan_epeistes_b_brise_garde_du_bourreau"
display_name = "Brise-garde du bourreau"
description = "Une frappe lourde est préparée avec un long télégraphe."
source = 1
rank = 2
owner_id = &"clan_epeistes"
chakra_cost = 28.0
cooldown = 14.0
tags = Array[StringName]([&"CC", &"MELEE"])
design_tags = PackedStringArray("Heavy attack", "Guard break", "Feint")
details = "Une frappe lourde est préparée avec un long télégraphe. Le joueur peut annuler volontairement la préparation en consommant 1 Fil et effectuer à la place une petite coupe latérale rapide.

Mécanique : Si la frappe lourde touche une garde ou un bouclier, elle inflige surtout des dégâts de posture et repousse ; sur une cible sans garde, les dégâts restent modérés pour éviter l'one-shot.

Synergies : Le vrai pouvoir est le mindgame entre charge et feinte.

Contre-jeu : Sans Fil, aucune feinte. La frappe lourde est très facile à esquiver si le joueur la lance sans setup."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_csep5"]
script = ExtResource("2_3fpi1")
id = &"clan_epeistes_a_duel_dans_la_brume_rouge"
display_name = "Duel dans la brume rouge"
description = "L'Épéiste crée une brume basse autour de lui et d'une cible proche."
source = 1
rank = 3
owner_id = &"clan_epeistes"
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"AOE", &"MELEE", &"BUFF"])
design_tags = PackedStringArray("Zone duel", "Information", "Tempo")
details = "L'Épéiste crée une brume basse autour de lui et d'une cible proche. Les deux restent visibles l'un pour l'autre à courte portée mais les alliés extérieurs voient des silhouettes moins précises à travers la brume.

Mécanique : Dans la zone, réussir une parade ou un sweet spot donne immédiatement 1 Fil ; subir un contrôle lourd dissipe la brume. La cible peut sortir librement mais révèle alors sa trajectoire par une traînée.

Synergies : Crée un espace de duel sans enfermer ni isoler techniquement le joueur adverse.

Contre-jeu : Quitter la zone est toujours possible. Les AOE externes continuent de fonctionner et l'Épéiste ne gagne aucune immunité."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_b85xa"]
script = ExtResource("2_3fpi1")
id = &"clan_epeistes_s_maitrise_des_sept_lames"
display_name = "Maîtrise des sept lames"
description = "Pendant quelques secondes, l'Épéiste peut dépenser ses charges de Fil pour invoquer des \"formes\" spectrales d'armes : Forme lourde pour bloquer un frontal, Forme longue pour étendre une coupe, Forme double pour effectuer deux frappes croisées."
source = 1
rank = 4
owner_id = &"clan_epeistes"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"BUFF"])
design_tags = PackedStringArray("Mode", "Arsenal abstrait", "Choix séquencé")
details = "Pendant quelques secondes, l'Épéiste peut dépenser ses charges de Fil pour invoquer des \"formes\" spectrales d'armes : Forme lourde pour bloquer un frontal, Forme longue pour étendre une coupe, Forme double pour effectuer deux frappes croisées.

Mécanique : Chaque Forme ne peut être utilisée qu'une fois par activation et modifie la prochaine technique ou attaque, puis disparaît. La maîtrise vient de l'ordre choisi, pas d'un simple buff global.

Synergies : Ultime compatible avec n'importe quelle arme réelle, riche en décisions et en expression mécanique.

Contre-jeu : Le mode ne crée pas de Fil gratuitement. Un joueur qui entre sans ressource n'a que la forme de base et perd une grande partie du potentiel."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_8yctu"]
script = ExtResource("1_2nrr7")
id = &"clan_epeistes"
display_name = "Épéistes"
village_id = &"kiri"
description = "Héritiers des sept épées de Kiri."
identity = "Les Épéistes jouent autour de la maîtrise de l'arme, de la garde et du Tempo de lame. Le kit doit rester compatible avec différents modèles d'épées : les techniques décrivent des principes de combat plutôt qu'une arme légendaire spécifique. Le joueur accumule du Fil en réussissant des actions techniques, puis le dépense pour des manœuvres avancées."
signature = "Fil : jusqu'à 3 charges gagnées par parade réussie, attaque touchée en bout de portée ou récupération correcte d'une arme lancée. Le Fil améliore la précision, le déplacement ou la garde de certaines techniques, pas simplement leurs dégâts."
jutsu = Array[ExtResource("2_3fpi1")]([SubResource("Resource_87s5h"), SubResource("Resource_dx1yj"), SubResource("Resource_p1niu"), SubResource("Resource_csep5"), SubResource("Resource_b85xa")])
placeholder = false

