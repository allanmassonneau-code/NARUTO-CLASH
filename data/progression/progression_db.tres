[sub_resource type="Resource" id="Resource_d4g6w"]
script = ExtResource("1_2nrr7")
id = &"clan_roran"
display_name = "Roran"
village_id = &"suna"
description = "Gardiens de la veine du dragon."
identity = "Le clan Roran se joue comme un maître d'éventail et de rythme. Contrairement au Fûton pur, il ne crée pas principalement des lames de vent : il alterne des Postures d'éventail qui changent la fonction de ses attaques, accumule des Battements et utilise ces Battements pour rediriger, repousser ou accélérer. C'est un kit de tempo et de lecture."
signature = "Battements : les techniques Roran génèrent jusqu'à 3 Battements. Le joueur peut les dépenser pour renforcer un prochain mouvement d'éventail. Certaines techniques changent selon la Posture actuelle : Ouverte favorise le contrôle de zone ; Fermée favorise la précision et la mobilité. Changer de posture est intégré aux casts, pas un bouton séparé permanent."
jutsu = Array[ExtResource("2_3fpi1")]([SubResource("Resource_mo2te"), SubResource("Resource_l5vpp"), SubResource("Resource_ilny3"), SubResource("Resource_t53tm"), SubResource("Resource_fetnm")])
placeholder = false

[sub_resource type="Resource" id="Resource_6ygog"]
script = ExtResource("2_3fpi1")
id = &"clan_sabaku_d_sable_gardien"
display_name = "Sable gardien"
description = "Une petite masse de sable flotte autour du Sabaku."
source = 1
rank = 0
owner_id = &"clan_sabaku"
chakra_cost = 12.0
cooldown = 6.0
tags = Array[StringName]([&"DEFENSIVE"])
design_tags = PackedStringArray("Interception automatique limitée", "Ressource", "Recast")
details = "Une petite masse de sable flotte autour du Sabaku. Le premier projectile léger venant d'un arc frontal est automatiquement bloqué en consommant une portion de Réserve.

Mécanique : Le joueur peut réactiver pour envoyer immédiatement le sable restant comme petite gifle directionnelle, sacrifiant la défense. L'auto-interception possède un délai interne clair.

Synergies : Introduit le principe fondamental : le même sable ne peut pas défendre et attaquer simultanément.

Contre-jeu : Arc frontal seulement, attaques lourdes traversantes et Réserve visible. Après une interception, une vraie fenêtre vulnérable existe."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_3yvdc"]
script = ExtResource("2_3fpi1")
id = &"clan_sabaku_c_main_des_dunes"
display_name = "Main des dunes"
description = "Une main de sable se forme au sol et avance vers le point visé."
source = 1
rank = 1
owner_id = &"clan_sabaku"
chakra_cost = 20.0
cooldown = 10.0
tags = Array[StringName]([&"MOVEMENT", &"DASH", &"CC"])
design_tags = PackedStringArray("Bras dirigé", "Grab conditionnel", "Reposition")
details = "Une main de sable se forme au sol et avance vers le point visé. Elle peut contourner légèrement un obstacle bas. Au contact, elle serre la cible et la tire d'une courte distance avant de se désagréger.

Mécanique : Une cible touchée auparavant par du sable porte du Grain marqué ; contre elle, la main se forme plus vite mais ne tire pas plus fort.

Synergies : Outil de déplacement précis, utile pour sortir quelqu'un d'un couvert ou le rapprocher d'une zone.

Contre-jeu : Main visible au sol, destructible avant fermeture et traction courte. Un dash au bon moment la fait rater."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_seieh"]
script = ExtResource("2_3fpi1")
id = &"clan_sabaku_b_cercueil_de_sable"
display_name = "Cercueil de sable"
description = "Le Sabaku envoie une grande portion de sa Réserve autour d'une cible."
source = 1
rank = 2
owner_id = &"clan_sabaku"
chakra_cost = 28.0
cooldown = 14.0
tags = Array[StringName]([&"MELEE", &"CC"])
design_tags = PackedStringArray("Capture progressive", "Ressource engagée", "Exécution conditionnelle")
details = "Le Sabaku envoie une grande portion de sa Réserve autour d'une cible. Pendant une courte fenêtre, le sable se referme progressivement ; si la cible reste dans la zone, elle est emprisonnée brièvement dans un cocon destructible.

Mécanique : Le Sabaku doit maintenir une partie de sa Réserve engagée tant que le cocon existe. Réactiver écrase le cocon pour infliger un burst modéré et le détruire immédiatement ; attendre permet surtout de contrôler.

Synergies : Choix intéressant entre contrôle d'équipe et dégâts. Main des dunes aide à empêcher la sortie pendant la fermeture.

Contre-jeu : Pré-zone visible, possibilité de dash avant fermeture, cocon attaquable par les alliés et perte massive de Réserve pendant son maintien."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_vkx2a"]
script = ExtResource("2_3fpi1")
id = &"clan_sabaku_a_mer_de_sable_mouvante"
display_name = "Mer de sable mouvante"
description = "Le Sabaku répand une large couche de sable dans une zone."
source = 1
rank = 3
owner_id = &"clan_sabaku"
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"AOE"])
design_tags = PackedStringArray("Terrain mobile", "Ressource", "Surf")
details = "Le Sabaku répand une large couche de sable dans une zone. La surface se déplace lentement dans une direction choisie et entraîne légèrement les personnages avec elle.

Mécanique : Le lanceur peut surfer rapidement sur sa propre mer et rappeler une partie du sable derrière lui, réduisant la zone mais régénérant sa Réserve. Les ennemis qui sprintent à contre-courant laissent un Grain marqué.

Synergies : Contrôle de terrain dynamique, différent d'une simple zone de slow. Sert à déplacer un combat entier et recharger tactiquement le kit.

Contre-jeu : Coût initial élevé, zone lente et aucune immobilisation. Quitter les bords latéraux reste possible."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_qpujo"]
script = ExtResource("2_3fpi1")
id = &"clan_sabaku_s_mausolee_du_desert"
display_name = "Mausolée du désert"
description = "Toute la Réserve disponible se fragmente en quatre piliers de sable autour d'une zone."
source = 1
rank = 4
owner_id = &"clan_sabaku"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"CC"])
design_tags = PackedStringArray("Construction massive", "Multi-capture", "Gestion ressource")
details = "Toute la Réserve disponible se fragmente en quatre piliers de sable autour d'une zone. Le joueur peut commander successivement chaque pilier pour balayer vers le centre, créant quatre fenêtres de compression.

Mécanique : Une cible frappée par deux balayages différents reçoit un Sceau d'ensevelissement ; au troisième, elle est brièvement enfermée dans un sarcophage individuel. Les piliers dépensés disparaissent et rendent progressivement leur sable.

Synergies : Ultime où la maîtrise des timings et des angles compte davantage que les dégâts bruts.

Contre-jeu : Les balayages sont séquentiels, visibles et évitables. Consommer toute la Réserve laisse le Sabaku presque sans défense après l'ultime."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_su0vg"]
script = ExtResource("1_2nrr7")
id = &"clan_sabaku"
display_name = "Sabaku"
village_id = &"suna"
description = "Maîtres du sable."
identity = "Le clan Sabaku commande une masse de sable autonome qui agit comme une extension du personnage. Le sable n'est pas du Doton classique : il peut rester en suspension, intercepter, poursuivre et construire des volumes mobiles. Le joueur gère une Réserve de sable qui circule entre défense et attaque."
signature = "Réserve de sable : jauge représentant la quantité actuellement disponible autour du joueur. Créer une défense immobilise temporairement du sable ; lancer une grosse attaque en dépense. Le sable revient progressivement au joueur ou plus vite si une structure est rappelée."
jutsu = Array[ExtResource("2_3fpi1")]([SubResource("Resource_6ygog"), SubResource("Resource_3yvdc"), SubResource("Resource_seieh"), SubResource("Resource_vkx2a"), SubResource("Resource_qpujo")])
