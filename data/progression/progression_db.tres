design_tags = PackedStringArray("Piège", "Barrière conditionnelle", "Contrôle")
details = "Le joueur plante quatre arcs électriques autour d'une petite zone. Après un court délai, des liens apparaissent entre les points. Traverser un lien consomme 1 Charge sur la cible et provoque une secousse ; sans Charge, le lien n'inflige qu'un ralentissement bref.

Mécanique : La cage ne possède pas de mur physique. Les points peuvent être détruits un à un, ouvrant des sorties.

Synergies : Très forte après Arc sauteur : plusieurs ennemis chargés doivent choisir entre rester groupés ou payer les secousses pour sortir.

Contre-jeu : Télégraphe clair et points destructibles. Les dashes qui franchissent un lien le déclenchent mais ne sont pas annulés."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_k7nhc"]
script = ExtResource("2_3fpi1")
