[sub_resource type="Resource" id="Resource_pgec2"]
script = ExtResource("2_3fpi1")
id = &"clan_hoki_a_dissection_de_combat"
display_name = "Dissection de combat"
description = "Après une courte canalisation sur une cible visible, le Hôki crée un Profil biologique."
source = 1
rank = 3
owner_id = &"clan_hoki"
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"MELEE", &"DEBUFF"])
design_tags = PackedStringArray("Mark", "Analyse avancée", "Exécution conditionnelle")
details = "Après une courte canalisation sur une cible visible, le Hôki crée un Profil biologique. Pendant quelques secondes, ses attaques révèlent une jauge de Saturation spécifique à cette cible et gagnent un effet selon son comportement récent : mobilité, défense ou spam de jutsu.

Mécanique : Atteindre le seuil de Saturation ne stun pas : cela déclenche une Crise adaptée — perte d'accélération, fragilité de garde ou hausse temporaire des coûts de chakra.

Synergies : Technique de chasseur qui récompense l'observation réelle et le choix de la bonne toxine.

Contre-jeu : Canalisation cassée par la ligne de vue et Profil visible. La cible peut varier son comportement pour empêcher le Hôki d'exploiter une seule faiblesse."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_h1vh8"]
script = ExtResource("2_3fpi1")
id = &"clan_hoki_s_chimere_de_laboratoire"
display_name = "Chimère de laboratoire"
description = "Le Hôki ouvre trois emplacements de Mutation pendant quelques secondes."
source = 1
rank = 4
owner_id = &"clan_hoki"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"BUFF"])
design_tags = PackedStringArray("Transformation", "Adaptation", "Choix en temps réel")
details = "Le Hôki ouvre trois emplacements de Mutation pendant quelques secondes. Chaque fois qu'il subit une catégorie d'effet significative — projectile, mêlée, contrôle — il peut choisir d'occuper un emplacement avec une adaptation correspondante.

Mécanique : Une adaptation ne donne jamais immunité totale : elle réduit la répétition de cette catégorie et modifie une attaque Hôki en réponse. Les trois emplacements imposent donc de décider ce qui mérite d'être contré.

Synergies : Ultime extrêmement complexe et réactif, fidèle à l'identité de chercheur.

Contre-jeu : Le mode commence sans bonus, nécessite d'être exposé et chaque adaptation est visible sur le modèle. Une composition variée force de vrais choix."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_5knxs"]
script = ExtResource("1_2nrr7")
