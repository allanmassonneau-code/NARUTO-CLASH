[sub_resource type="Resource" id="Resource_qputj"]
script = ExtResource("2_bdunr")
id = &"clan_chinoike_s_arcanes_maudites_sang_de_possession_mort"
display_name = "Arcanes Maudites : Sang de possession mortelle"
description = "Une malédiction utilisant le sang qui oblige la victime à subir le même nombre de dégâts que vous. Une fois activée, vous ne pourrez plus être mis KO, sauf par certaines attaques comme les techniques d'emprisonnement et vous pourrez utiliser un outil de ninja spécial. En volant le sang de votre adversaire avec une attaque au corps à corps, vous pourrez réaliser un rituel en effectuant une commande supplémentaire pour vous empaler et mettre votre adversaire KO. Si vous recevez des dégâts durant le rituel, ceux-ci seront aussi infligés à l'adversaire dont vous avez volé le sang."
