design_tags = PackedStringArray("Boomerang", "Ancre", "Rebond")
details = "Un grand shuriken est lancé horizontalement. Sur recast, il plante une lame dans la première surface proche et crée une Ancre au lieu de revenir. Sans recast, il revient vers le lanceur.

Mécanique : Si le retour passe près d'une Ancre existante, sa trajectoire se courbe légèrement vers celle-ci avant de revenir.

Synergies : Dès le premier rang, le joueur choisit entre dégâts immédiats et préparation du réseau.

Contre-jeu : Le projectile est large et visible. Planter l'Ancre sacrifie le potentiel de double hit."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_p075x"]
script = ExtResource("2_3fpi1")
id = &"clan_fuma_c_fil_du_chasseur"
display_name = "Fil du chasseur"
