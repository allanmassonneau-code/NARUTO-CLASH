details = "Une lance d'électricité magnétisée part en ligne et s'accroche au premier ennemi touché. Le joueur choisit immédiatement, via direction de déplacement, entre l'attirer légèrement ou se tirer lui-même vers la cible.

Mécanique : Chaque Charge consommée augmente la force du déplacement, jusqu'à 3. Le sort n'étourdit pas : il change brutalement la géométrie du duel.

Synergies : Peut rapprocher un fuyard, créer un engage ou servir de grappin offensif. Pas ionique permet ensuite de tourner autour de la cible.

Contre-jeu : Skillshot étroit. Consommer toutes les Charges enlève des ressources aux autres sorts ; un mauvais choix de traction peut mettre le Raiton en danger."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_0703u"]
script = ExtResource("2_3fpi1")
id = &"raiton_b_cage_de_foudre"
display_name = "Cage de foudre"
description = "Le joueur plante quatre arcs électriques autour d'une petite zone."
source = 0
rank = 2
