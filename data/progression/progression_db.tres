details = "Le Kaguya tire successivement des phalanges depuis ses doigts. Chaque tir peut être légèrement orienté indépendamment. Les impacts dans le décor créent de petits Éclats récupérables.

Mécanique : Maintenir le dernier tir consomme davantage de Densité pour le faire éclater en trois fragments après un court vol.

Synergies : Poke de précision pouvant aussi semer des ressources sur la carte pour une future retraite.

Contre-jeu : Chaque balle est esquivable, le Kaguya doit ralentir pour viser, et les Éclats éloignés peuvent être difficiles à récupérer."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_tegbe"]
script = ExtResource("2_3fpi1")
id = &"clan_kaguya_a_foret_de_tessons"
display_name = "Forêt de tessons"
description = "Le Kaguya fait jaillir une première ligne de pointes osseuses."
source = 1
rank = 3
owner_id = &"clan_kaguya"
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"AOE"])
design_tags = PackedStringArray("Terrain", "Éruption", "Recyclage")
details = "Le Kaguya fait jaillir une première ligne de pointes osseuses. Tous les Éclats présents dans une grande zone se transforment ensuite en petites pointes secondaires orientées vers la ligne principale.

Mécanique : Plus le joueur a laissé d'Éclats pendant le combat, plus le motif devient complexe ; le nombre de hits par cible reste plafonné.

Synergies : Récompense la mémoire du terrain et transforme les anciennes munitions en menace différée.

Contre-jeu : Sans Éclats préalables, la technique est beaucoup plus linéaire. Les zones de pointes sont annoncées par des fissures blanches."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_72keo"]
script = ExtResource("2_3fpi1")
id = &"clan_kaguya_s_shikotsumyaku_danse_du_dernier_squelette"
display_name = "Shikotsumyaku — Danse du dernier squelette"
description = "Le Kaguya condense toute sa Densité en une armure osseuse externe composée de segments."
source = 1
rank = 4
owner_id = &"clan_kaguya"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"AOE", &"MELEE", &"BUFF"])
design_tags = PackedStringArray("Transformation", "Armure offensive", "Finisher")
details = "Le Kaguya condense toute sa Densité en une armure osseuse externe composée de segments. Chaque segment peut être brisé par les dégâts ou volontairement arraché par le joueur pour créer une arme temporaire : lance, bouclier ou fouet.

Mécanique : Lorsqu'il ne reste plus qu'un segment, le joueur peut le sacrifier pour une charge perforante qui termine immédiatement le mode.

Synergies : Ultime modulable : survivre, changer d'arme en temps réel ou convertir toute la défense en attaque finale.

Contre-jeu : Chaque arme consommée réduit la protection restante. Le mode ne régénère pas de Densité et finit rapidement si l'ennemi force plusieurs échanges."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_5wj3x"]
script = ExtResource("1_2nrr7")
id = &"clan_kaguya"
display_name = "Kaguya"
village_id = &"ame"
description = "Shikotsumyaku : manipulation des os."
identity = "Le clan Kaguya transforme son squelette en arsenal. Sa ressource, la Densité osseuse, circule entre armes, armure et terrain. Les os détachés restent brièvement comme Éclats et peuvent être réutilisés par d'autres techniques, donnant au kit une économie matérielle très concrète."
signature = "Densité : jauge qui se régénère lentement. Les grosses techniques consomment beaucoup de Densité mais peuvent laisser des Éclats au sol. Ramasser ou rappeler des Éclats restaure une portion de la jauge. Le Kaguya doit donc décider quand laisser ses ressources sur la carte."
jutsu = Array[ExtResource("2_3fpi1")]([SubResource("Resource_3q8pv"), SubResource("Resource_p8jpx"), SubResource("Resource_h5u53"), SubResource("Resource_tegbe"), SubResource("Resource_72keo")])
placeholder = false

[sub_resource type="Resource" id="Resource_blayv"]
script = ExtResource("2_3fpi1")
id = &"clan_kami_d_shuriken_de_papier"
display_name = "Shuriken de papier"
description = "Le joueur lance trois shuriken de papier en léger éventail."
source = 1
rank = 0
owner_id = &"clan_kami"
