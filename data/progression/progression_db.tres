details = "Le Fûma relie deux Ancres ou une Ancre à lui-même par un fil presque invisible à distance mais brillant de près. Traverser le fil applique un bref ralentissement et révèle la cible.

Mécanique : Le lanceur peut réactiver pour se tirer rapidement vers l'une des extrémités, rompant le fil.

Synergies : Le même outil sert de piège d'information ou de déplacement, imposant un vrai choix.

Contre-jeu : Une seule ligne active, fil détectable à proximité et ancres destructibles."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_3g4bw"]
script = ExtResource("2_3fpi1")
id = &"clan_fuma_b_demon_a_quatre_lames"
display_name = "Démon à quatre lames"
description = "Le grand shuriken se sépare en quatre lames après une distance choisie par recast."
source = 1
rank = 2
owner_id = &"clan_fuma"
chakra_cost = 28.0
