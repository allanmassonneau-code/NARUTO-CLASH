[sub_resource type="Resource" id="Resource_6j1cu"]
script = ExtResource("2_3fpi1")
id = &"clan_senju_d_impulsion_ancestrale"
display_name = "Impulsion ancestrale"
description = "Le Senju concentre son chakra dans tout le corps."
source = 1
rank = 0
owner_id = &"clan_senju"
chakra_cost = 12.0
cooldown = 6.0
tags = Array[StringName]([&"BUFF"])
design_tags = PackedStringArray("Self-buff", "Ressource", "Anti-slow")
details = "Le Senju concentre son chakra dans tout le corps. Il supprime les ralentissements légers, gagne brièvement de la ténacité aux déplacements forcés et reçoit 1 Vigueur si l'effet retire réellement un contrôle.

Mécanique : La technique n'est pas un cleanse universel : elle ne retire ni stun dur ni sceau. Si lancée sans debuff, elle donne seulement une courte accélération.

Synergies : Permet d'entrer dans le cycle de Vigueur et de convertir une mauvaise situation en reprise de tempo.

Contre-jeu : Le bonus est court et la technique gaspillée à vide offre peu. Les ennemis peuvent attendre sa fin avant d'engager leurs vrais contrôles."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_aaks1"]
script = ExtResource("2_3fpi1")
id = &"clan_senju_c_poigne_de_seve"
display_name = "Poigne de sève"
description = "Un coup de paume lourd marque la cible d'un Sceau de sève pendant quelques secondes."
source = 1
rank = 1
owner_id = &"clan_senju"
chakra_cost = 20.0
cooldown = 10.0
tags = Array[StringName]([&"MELEE", &"BUFF", &"HEAL"])
design_tags = PackedStringArray("Mêlée", "Vol de tempo", "Sustain")
details = "Un coup de paume lourd marque la cible d'un Sceau de sève pendant quelques secondes. Chaque fois que cette cible inflige des dégâts au Senju, une petite portion est convertie en Vigueur potentielle ; au troisième déclenchement, le sceau se rompt et rend une petite quantité de vie.

Mécanique : Consommer 1 Vigueur à l'impact transforme le coup en saisie courte qui stoppe l'élan de la cible sans l'immobiliser longtemps.

Synergies : Crée un duel où frapper le Senju alimente sa résistance, mais où ignorer le sceau laisse au Senju l'initiative.

Contre-jeu : Portée de mêlée et marque visible. L'adversaire peut temporiser jusqu'à expiration ou changer de cible."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_kn6v8"]
script = ExtResource("2_3fpi1")
id = &"clan_senju_b_rempart_de_racines"
display_name = "Rempart de racines"
description = "Le Senju fait surgir un rempart courbe."
source = 1
rank = 2
owner_id = &"clan_senju"
chakra_cost = 28.0
cooldown = 14.0
tags = Array[StringName]([&"AOE", &"DEFENSIVE"])
design_tags = PackedStringArray("Mur", "Cover", "Ressource")
details = "Le Senju fait surgir un rempart courbe. Sans Vigueur, il s'agit d'un couvert destructible. En consommant 1/2/3 charges, le mur gagne respectivement plus de largeur, une excroissance latérale, puis une brève repousse si un ennemi se trouve exactement sur la zone d'apparition.

Mécanique : Le rempart ne peut pas fermer totalement une porte ou emprisonner un joueur. Sa forme favorise les angles plutôt que le blocage brut.

Synergies : Sert à protéger, couper une ligne de tir et créer un terrain favorable à Floraison de combat.

Contre-jeu : Télégraphe au sol, structure destructible, coût de ressource important si l'on veut la version complète."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_g8wb1"]
script = ExtResource("2_3fpi1")
id = &"clan_senju_a_floraison_de_combat"
display_name = "Floraison de combat"
description = "Le Senju plante un noyau vital qui fait pousser plusieurs veines au sol."
source = 1
rank = 3
owner_id = &"clan_senju"
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"AOE", &"CC", &"HEAL"])
design_tags = PackedStringArray("Zone hybride", "Sustain", "Root conditionnel")
details = "Le Senju plante un noyau vital qui fait pousser plusieurs veines au sol. Les alliés qui restent près d'une veine reçoivent de petites pulsations de récupération ; les ennemis qui traversent deux veines différentes en peu de temps sont brièvement Enracinés.

Mécanique : Le noyau consomme automatiquement 1 Vigueur si disponible pour étendre une veine supplémentaire vers la direction du viseur.

Synergies : Le sort récompense le placement et les déplacements forcés : on peut pousser une cible à travers une seconde veine plutôt que compter sur une immobilisation gratuite.

Contre-jeu : Noyau destructible, soins modestes et racine entièrement évitable si l'adversaire ne retraverse pas plusieurs veines."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_i2it6"]
script = ExtResource("2_3fpi1")
id = &"clan_senju_s_avatar_du_grand_bois"
display_name = "Avatar du grand bois"
description = "Le Senju dépense toute sa Vigueur pour former une armure végétale massive autour de lui."
source = 1
rank = 4
owner_id = &"clan_senju"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"AOE", &"BUFF"])
design_tags = PackedStringArray("Transformation", "Armure", "Recast")
details = "Le Senju dépense toute sa Vigueur pour former une armure végétale massive autour de lui. Chaque charge consommée ajoute un segment d'armure. Tant que des segments restent, ses attaques de mêlée gagnent de la portée et la première attaque reçue de chaque direction brise un segment au lieu de provoquer tout son déplacement forcé.

Mécanique : Réactiver sacrifie les segments restants pour envoyer des bras-racines dans les directions correspondantes, créant un finisher de zone dont la taille dépend de ce qui n'a pas été détruit.

Synergies : Ultime à double usage : survivre à un focus ou conserver l'armure pour menacer un relâchement massif.

Contre-jeu : Transformation lente, très visible, pas d'immunité aux dégâts continus. Les adversaires peuvent user les segments avant d'engager fort."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_vu0s6"]
script = ExtResource("1_2nrr7")
id = &"clan_senju"
display_name = "Senju"
village_id = &"konoha"
description = "Lignée du bois et de la vitalité."
identity = "Le kit Senju tourne autour de la Vigueur : encaisser, rester actif et transformer la pression reçue en ressources. Il mélange robustesse, contrôle du terrain et poussées de puissance. Cette version assume une expression végétale du chakra à haut rang ; si le lore du serveur réserve strictement le Mokuton, les visuels peuvent être remplacés par des manifestations de chakra vital sans changer les mécaniques."
signature = "Vigueur : le Senju gagne jusqu'à 3 charges en infligeant ou recevant des dégâts significatifs, avec un délai interne. Plusieurs techniques peuvent consommer 1 à 3 Vigueurs pour obtenir une variante renforcée. La Vigueur expire hors combat."
jutsu = Array[ExtResource("2_3fpi1")]([SubResource("Resource_6j1cu"), SubResource("Resource_aaks1"), SubResource("Resource_kn6v8"), SubResource("Resource_g8wb1"), SubResource("Resource_i2it6")])
placeholder = false

[sub_resource type="Resource" id="Resource_fqbf2"]
script = ExtResource("2_3fpi1")
id = &"clan_uchiha_d_sharingan_observation"
display_name = "Sharingan — Observation"
description = "Le Sharingan s'active à faible coût continu."
source = 1
rank = 0
owner_id = &"clan_uchiha"
chakra_cost = 12.0
cooldown = 6.0
tags = Array[StringName]([&"BUFF"])
design_tags = PackedStringArray("Toggle", "Information", "Ressource")
details = "Le Sharingan s'active à faible coût continu. Les animations de mudras ennemis proches deviennent légèrement plus lisibles pour le joueur et observer une attaque complète génère 1 Lecture sur son auteur.

Mécanique : Le mode n'affiche pas la future trajectoire, ne révèle pas l'invisible et ne ralentit pas le temps. Couper le Sharingan préserve les Lectures déjà gagnées pour quelques secondes.

Synergies : Base du kit : le joueur doit choisir quand payer du chakra pour accumuler de l'information.

Contre-jeu : Drain continu et nécessité de réellement regarder la cible. Les attaques hors écran, pièges au sol et feintes réduisent son avantage."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_va5bs"]
script = ExtResource("2_3fpi1")
id = &"clan_uchiha_c_genjutsu_faux_pas"
display_name = "Genjutsu — Faux pas"
description = "L'Uchiha consomme 1 Lecture sur une cible visible pour créer, uniquement pour elle, une fausse image de l'Uchiha qui effectue un dash dans une direction choisie."
source = 1
rank = 1
owner_id = &"clan_uchiha"
chakra_cost = 20.0
cooldown = 10.0
tags = Array[StringName]([&"BUFF", &"DEBUFF"])
design_tags = PackedStringArray("Illusion", "Decoy", "Mindgame")
details = "L'Uchiha consomme 1 Lecture sur une cible visible pour créer, uniquement pour elle, une fausse image de l'Uchiha qui effectue un dash dans une direction choisie. Le vrai personnage reste visible mais pendant une fraction de seconde les deux silhouettes sont visuellement équivalentes.

Mécanique : Si la cible frappe l'illusion, celle-ci éclate et applique un bref Flou de visée : son prochain lock-on ne s'accroche pas automatiquement.

Synergies : Le sort ne contrôle pas les inputs ; il crée une vraie fausse information que le joueur peut lire ou ignorer.

Contre-jeu : Un adversaire qui suit les sons, les effets au sol ou attend la fin de l'illusion ne subit presque rien. Une seule cible voit le faux."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_hv7q7"]
script = ExtResource("2_3fpi1")
id = &"clan_uchiha_b_mimetisme_analytique"
display_name = "Mimétisme analytique"
description = "Après avoir observé jusqu'au bout une technique de nature de rang B ou inférieur, l'Uchiha peut consommer 2 Lectures de son lanceur pour enregistrer son profil pendant quelques secondes."
source = 1
rank = 2
owner_id = &"clan_uchiha"
chakra_cost = 28.0
cooldown = 14.0
tags = Array[StringName]([&"BUFF"])
design_tags = PackedStringArray("Copie limitée", "Adaptation", "Recast")
details = "Après avoir observé jusqu'au bout une technique de nature de rang B ou inférieur, l'Uchiha peut consommer 2 Lectures de son lanceur pour enregistrer son profil pendant quelques secondes. Un recast lance une version mimétique simplifiée.

Mécanique : La copie reproduit uniquement la géométrie principale — projectile, cône, dash ou zone — avec des dégâts neutres réduits. Elle ne copie ni ressources propres, ni invocations, ni passifs, ni effets de clan.

Synergies : Mécanique extrêmement flexible qui récompense la connaissance des kits adverses sans voler leurs identités.

Contre-jeu : Il faut voir le cast complet, disposer de Lectures et utiliser la copie rapidement. Les techniques incompatibles donnent simplement un bonus de Lecture au lieu d'être copiées."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_8uff5"]
script = ExtResource("2_3fpi1")
id = &"clan_uchiha_a_sharingan_prediction"
display_name = "Sharingan — Prédiction"
description = "L'Uchiha cible un adversaire possédant au moins 2 Lectures et entre dans une fenêtre de prédiction très courte."
source = 1
rank = 3
owner_id = &"clan_uchiha"
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"MELEE", &"MOVEMENT", &"DASH", &"COUNTER"])
design_tags = PackedStringArray("Parade avancée", "Reposition", "Duel")
details = "L'Uchiha cible un adversaire possédant au moins 2 Lectures et entre dans une fenêtre de prédiction très courte. Si cette cible le touche directement pendant la fenêtre, l'Uchiha consomme 2 Lectures, réduit fortement l'impact et effectue automatiquement un pas latéral choisi au dernier instant par le joueur.

Mécanique : La parade ne déclenche pas sur les dégâts de zone déjà posés. Si elle réussit, le prochain coup de l'Uchiha contre cette cible gagne un léger bonus de portée, pas de dégâts garantis.

Synergies : Crée un échange lisible de type \"je sais ce que tu vas faire\", sans invulnérabilité gratuite.

Contre-jeu : Fenêtre très courte et ciblée sur une seule personne. Une feinte ou une attaque d'un allié la fait échouer."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_w14xu"]
script = ExtResource("2_3fpi1")
id = &"clan_uchiha_s_susanoo_gardien_incomplet"
display_name = "Susanoo — Gardien incomplet"
description = "Un squelette spectral enveloppe partiellement l'Uchiha."
source = 1
rank = 4
owner_id = &"clan_uchiha"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"BUFF"])
design_tags = PackedStringArray("Avatar défensif", "Arc de garde", "Recast")
details = "Un squelette spectral enveloppe partiellement l'Uchiha. Il possède une jauge d'intégrité séparée et protège surtout l'arc frontal. Les attaques qui frappent le dos touchent normalement le joueur.

Mécanique : Chaque Lecture encore présente sur les ennemis proches permet au Susanoo de générer une flèche spectrale à usage unique. Le joueur peut réactiver pour tirer toutes les flèches successivement vers les cibles correspondantes, puis le Susanoo se dissipe.

Synergies : L'ultime convertit l'information accumulée pendant le combat en puissance défensive puis offensive.

Contre-jeu : Très visible, mobilité réduite, angles morts réels et jauge destructible. Briser la ligne de vue avant les flèches annule leur guidage."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_x0xpu"]
script = ExtResource("1_2nrr7")
id = &"clan_uchiha"
display_name = "Uchiha"
village_id = &"konoha"
description = "Sharingan, feu et illusions."
identity = "Le kit Uchiha est fondé sur la Lecture. Le Sharingan ne donne pas une esquive automatique permanente : il récompense l'observation d'une cible, la mémorisation de ses actions et les réponses parfaitement timées. Le clan excelle dans le duel mental, les feintes et le contre."
signature = "Lecture : garder une cible dans son champ de vision pendant qu'elle attaque génère jusqu'à 3 Lectures sur elle. Les Lectures sont propres à chaque cible et disparaissent si elle reste hors vision trop longtemps. Les techniques Uchiha consomment ces informations pour améliorer une réponse, jamais pour auto-gagner le duel."
jutsu = Array[ExtResource("2_3fpi1")]([SubResource("Resource_fqbf2"), SubResource("Resource_va5bs"), SubResource("Resource_hv7q7"), SubResource("Resource_8uff5"), SubResource("Resource_w14xu")])
placeholder = false

[sub_resource type="Resource" id="Resource_7ukxn"]
script = ExtResource("2_3fpi1")
id = &"clan_uzumaki_d_fuda_d_entrave"
display_name = "Fuda d'entrave"
description = "Un petit sceau est lancé comme un projectile court."
source = 1
rank = 0
owner_id = &"clan_uzumaki"
chakra_cost = 12.0
cooldown = 6.0
tags = Array[StringName]([&"BUFF", &"DEBUFF"])
design_tags = PackedStringArray("Tag", "Debuff conditionnel", "Setup")
details = "Un petit sceau est lancé comme un projectile court. Sur ennemi, il devient un Glyphe d'entrave : le premier dash ou déplacement instantané utilisé avant expiration est raccourci et détruit le sceau. Sur le sol, il devient simplement un Glyphe neutre.

Mécanique : Le sceau n'empêche jamais l'utilisation de la mobilité ; il en réduit seulement la distance une fois.

Synergies : Prépare les chaînes et barrières tout en créant une réponse légère aux personnages très mobiles.

Contre-jeu : Projectile esquivable et sceau clairement visible. Une cible peut volontairement consommer l'effet avec un petit dash."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_lit17"]
script = ExtResource("2_3fpi1")
id = &"clan_uzumaki_c_chaine_de_scellement"
display_name = "Chaîne de scellement"
description = "Une chaîne de chakra relie le lanceur à un Glyphe ou à une cible marquée."
source = 1
rank = 1
owner_id = &"clan_uzumaki"
chakra_cost = 20.0
cooldown = 10.0
tags = Array[StringName]([&"CC"])
design_tags = PackedStringArray("Tether", "Ancre", "Recast")
details = "Une chaîne de chakra relie le lanceur à un Glyphe ou à une cible marquée. Tant que la portée n'est pas dépassée, le joueur peut réactiver pour tirer légèrement le point le plus léger vers le plus lourd.

Mécanique : Sur un Glyphe de terrain, cela fonctionne comme un grappin. Sur un ennemi, le déplacement est partagé entre les deux combattants plutôt qu'un pull unilatéral.

Synergies : Permet des repositionnements créatifs et donne de la valeur à chaque Glyphe déjà placé.

Contre-jeu : Chaîne visible, cassable en dépassant la portée ou en détruisant le Glyphe. Le recast possède un court délai."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_2qdho"]
script = ExtResource("2_3fpi1")
id = &"clan_uzumaki_b_barriere_quadrillee"
display_name = "Barrière quadrillée"
description = "Le joueur sélectionne jusqu'à trois Glyphes actifs."
source = 1
rank = 2
owner_id = &"clan_uzumaki"
chakra_cost = 28.0
cooldown = 14.0
tags = Array[StringName]([&"RANGED", &"PROJECTILE", &"AOE", &"DEFENSIVE"])
design_tags = PackedStringArray("Barrière", "Réseau", "Anti-projectile")
details = "Le joueur sélectionne jusqu'à trois Glyphes actifs. Des segments de barrière se forment entre eux pendant quelques secondes. Les personnages peuvent traverser, mais les projectiles perdent une partie de leur vitesse et de leur puissance à chaque segment franchi.

Mécanique : Un ennemi portant un Glyphe compte comme un sommet mobile, créant une barrière dynamique tant que les distances restent valides.

Synergies : Peut protéger une équipe, découper un champ de tir ou transformer un ennemi marqué en élément du propre réseau Uzumaki.

Contre-jeu : Les segments sont visibles, n'arrêtent pas la mêlée et disparaissent si un sommet est détruit ou s'éloigne trop."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_nf38h"]
script = ExtResource("2_3fpi1")
id = &"clan_uzumaki_a_sceau_de_renversement"
display_name = "Sceau de renversement"
description = "L'Uzumaki place un grand Glyphe sur une zone."
source = 1
rank = 3
owner_id = &"clan_uzumaki"
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"COUNTER"])
design_tags = PackedStringArray("Contre", "Stockage", "Redistribution")
details = "L'Uzumaki place un grand Glyphe sur une zone. La première technique hostile de zone ou projectile lourd qui le frappe est partiellement absorbée et stockée sous forme d'Écho.

Mécanique : Le joueur peut ensuite placer un Glyphe d'Écho ailleurs : il ne recrée pas le jutsu original, mais libère une onde neutre de même catégorie — explosion, ligne ou cône — avec puissance plafonnée.

Synergies : Le kit gagne une défense active qui transforme l'agression adverse en ressource de placement.

Contre-jeu : Un seul Écho à la fois, fenêtre d'absorption claire, ultimes non stockables et Glyphe destructible."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_ve33v"]
script = ExtResource("2_3fpi1")
id = &"clan_uzumaki_s_chaines_adamantines_prison_des_huit_sceaux"
display_name = "Chaînes adamantines — Prison des huit sceaux"
description = "Huit pointes de chakra apparaissent autour d'une large zone et projettent des chaînes entre les Glyphes existants."
source = 1
rank = 4
owner_id = &"clan_uzumaki"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"AOE", &"CC"])
design_tags = PackedStringArray("Réseau", "Capture progressive", "Objectif")
details = "Huit pointes de chakra apparaissent autour d'une large zone et projettent des chaînes entre les Glyphes existants. Chaque fois qu'un ennemi traverse une chaîne, il accumule 1 Verrou. À 3 Verrous, il est brièvement immobilisé et tous ses Verrous sont retirés.

Mécanique : Les chaînes ne bloquent jamais physiquement. Les alliés peuvent détruire les pointes extérieures pour ouvrir le réseau. Les Glyphes déjà préparés changent la forme de la prison.

Synergies : Ultime de contrôle construit : un bon Uzumaki prépare ses Glyphes avant l'activation et force plusieurs mauvaises trajectoires.

Contre-jeu : Sans préparation, le réseau est plus simple. Les pointes ont des PV et les Verrous expirent en sortant de la zone."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_r2evi"]
script = ExtResource("1_2nrr7")
id = &"clan_uzumaki"
display_name = "Uzumaki"
village_id = &"konoha"
description = "Sceaux et vitalité hors norme."
identity = "Les Uzumaki utilisent le fuinjutsu comme une grammaire de combat. Ils posent des Glyphes puis les relient, inversent ou déclenchent. Leur force vient de la préparation d'un espace et de la capacité à modifier les règles d'un affrontement pendant quelques secondes."
signature = "Glyphes : le joueur peut maintenir jusqu'à 4 Glyphes actifs sur le sol, un ennemi ou un allié. Les techniques suivantes peuvent consommer ou relier ces Glyphes. Un Glyphe est visible et peut être détruit s'il est posé sur le terrain."
jutsu = Array[ExtResource("2_3fpi1")]([SubResource("Resource_7ukxn"), SubResource("Resource_lit17"), SubResource("Resource_2qdho"), SubResource("Resource_nf38h"), SubResource("Resource_ve33v")])
placeholder = false

[sub_resource type="Resource" id="Resource_l85gl"]
script = ExtResource("2_3fpi1")
id = &"clan_nara_d_fil_d_ombre"
display_name = "Fil d'ombre"
description = "Une ombre fine file sur le sol en ligne droite."
source = 1
rank = 0
owner_id = &"clan_nara"
chakra_cost = 12.0
cooldown = 6.0
tags = Array[StringName]([&"RANGED", &"PROJECTILE", &"CC"])
design_tags = PackedStringArray("Skillshot au sol", "Tether", "Setup")
details = "Une ombre fine file sur le sol en ligne droite. Si elle touche un ennemi, elle crée un lien pendant quelques secondes ; si elle atteint un mur ou s'arrête au maximum de portée, elle crée une Ancre.

Mécanique : Le lien ne contrôle pas encore la cible mais révèle sa direction de déplacement et compte comme connexion pour les techniques suivantes.

Synergies : Outil de base du réseau Nara, utile même lorsqu'il manque la cible grâce à l'Ancre créée.

Contre-jeu : La ligne doit rester sur une surface continue et ne saute pas les fossés. Briser la ligne de vue avec un obstacle coupe le lien."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_gqgyh"]
script = ExtResource("2_3fpi1")
id = &"clan_nara_c_pas_jumeau"
display_name = "Pas jumeau"
description = "Sur une cible reliée, le Nara active un mimétisme pendant une courte fenêtre."
source = 1
rank = 1
owner_id = &"clan_nara"
chakra_cost = 20.0
cooldown = 10.0
tags = Array[StringName]([&"MELEE"])
design_tags = PackedStringArray("Mimétisme partiel", "Recast", "Duel")
details = "Sur une cible reliée, le Nara active un mimétisme pendant une courte fenêtre. Chaque fois qu'il effectue un déplacement latéral brusque, la cible reçoit une impulsion faible dans la direction miroir.

Mécanique : La technique n'imite ni attaques ni dashes complets. Le joueur peut réactiver pour rompre le lien et récupérer une petite portion de longueur d'ombre.

Synergies : Permet de dérégler le spacing adverse et de pousser subtilement vers une Ancre ou une zone alliée.

Contre-jeu : Effet faible individuellement, lien visible et cassable. Les mouvements verticaux ou immobilité neutralisent presque tout."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_me5rx"]
script = ExtResource("2_3fpi1")
id = &"clan_nara_b_couture_des_ombres"
display_name = "Couture des ombres"
description = "Le Nara choisit deux Ancres ; plusieurs aiguilles d'ombre remontent périodiquement le long du segment."
source = 1
rank = 2
owner_id = &"clan_nara"
chakra_cost = 28.0
cooldown = 14.0
tags = Array[StringName]([&"AOE", &"CC"])
design_tags = PackedStringArray("Piège entre ancres", "Root conditionnel")
details = "Le Nara choisit deux Ancres ; plusieurs aiguilles d'ombre remontent périodiquement le long du segment. Un ennemi qui traverse le segment au moment d'une pulsation est brièvement cloué au sol.

Mécanique : Chaque déclenchement consomme une partie de la longueur maximale du réseau, empêchant le spam infini.

Synergies : Transforme les Ancres D en véritables pièges et récompense la construction d'angles.

Contre-jeu : Pulsations rythmiques visibles et segment fixe. Détruire ou contourner une Ancre annule le piège."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_64lpy"]
script = ExtResource("2_3fpi1")
id = &"clan_nara_a_possession_tactique"
display_name = "Possession tactique"
description = "Sur une cible reliée avec suffisamment de longueur disponible, le Nara canalise et impose pendant quelques secondes une symétrie de déplacement : marcher en avant la fait marcher légèrement vers le Nara, marcher à gauche la pousse à droite, etc."
source = 1
rank = 3
owner_id = &"clan_nara"
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"CC"])
design_tags = PackedStringArray("Contrôle limité", "Symétrie", "Canalisation")
details = "Sur une cible reliée avec suffisamment de longueur disponible, le Nara canalise et impose pendant quelques secondes une symétrie de déplacement : marcher en avant la fait marcher légèrement vers le Nara, marcher à gauche la pousse à droite, etc.

Mécanique : La cible garde ses attaques, sa caméra et ses dashes. Les dashes rompent une partie de l'effet au prix d'un ralentissement bref après l'arrivée.

Synergies : C'est un contrôle de haute compétence qui perturbe sans retirer totalement les commandes. Idéal pour forcer une mauvaise orientation.

Contre-jeu : Canalisation interruptible, portée stricte, coût élevé en longueur d'ombre et cible toujours capable de riposter."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_syyvp"]
script = ExtResource("2_3fpi1")
id = &"clan_nara_s_crepuscule_des_cent_ombres"
display_name = "Crépuscule des cent ombres"
description = "Le Nara étend temporairement sa réserve d'ombre sur une large zone."
source = 1
rank = 4
owner_id = &"clan_nara"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"AOE"])
design_tags = PackedStringArray("Domaine", "Réseau automatique", "Gestion de ressource")
details = "Le Nara étend temporairement sa réserve d'ombre sur une large zone. Toutes ses Ancres se relient entre elles si aucun obstacle ne coupe le segment, formant un maillage.

Mécanique : Le joueur peut déplacer son point d'origine d'une Ancre à l'autre. Les ennemis qui traversent trop de segments en peu de temps gagnent des Charges d'Ombre ; à 3, leur prochain dash est annulé au départ et les charges disparaissent.

Synergies : Ultime de contrôle de trajectoire qui récompense énormément la préparation de terrain, sans immobiliser en permanence.

Contre-jeu : Le maillage est entièrement visible. Les ennemis peuvent détruire les Ancres ou rester dans une même cellule pour éviter d'accumuler des Charges."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_lvc6d"]
script = ExtResource("1_2nrr7")
id = &"clan_nara"
display_name = "Nara"
village_id = &"konoha"
description = "Manipulation des ombres."
identity = "Le Nara transforme les ombres en réseau de lignes et d'ancres. Son kit ne repose pas sur un unique hard-CC : il prépare des connexions, punit les trajectoires et peut brièvement imposer une symétrie de mouvement à une cible."
signature = "Ancres d'ombre : certaines techniques posent des points d'ombre sur le terrain. Une ligne d'ombre peut relier le Nara à une Ancre ou à un ennemi. Les obstacles coupent physiquement les lignes. La longueur disponible est limitée et constitue la ressource principale du kit."
jutsu = Array[ExtResource("2_3fpi1")]([SubResource("Resource_l85gl"), SubResource("Resource_gqgyh"), SubResource("Resource_me5rx"), SubResource("Resource_64lpy"), SubResource("Resource_syyvp")])
placeholder = false

[sub_resource type="Resource" id="Resource_rw7jj"]
script = ExtResource("2_3fpi1")
