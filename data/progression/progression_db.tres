rollable = true
id = &"sub_a_marque_d_echange_spatio_temporel"
display_name = "Marque d'échange spatio-temporel"
description = "Le joueur place une première marque puis une seconde sur deux surfaces distinctes."
source = 3
rank = 3
owner_id = &""
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"MOVEMENT", &"DASH"])
design_tags = PackedStringArray("Two-point swap", "Setup", "Recast")
details = "Le joueur place une première marque puis une seconde sur deux surfaces distinctes. Pendant quelques secondes, il peut réactiver pour échanger instantanément le contenu léger des deux petites zones : lui-même, un clone, une invocation légère ou un projectile compatible.

Mécanique : Les joueurs ennemis ne sont jamais téléportés de force, mais un projectile peut être déplacé d'une porte à l'autre.

Synergies : Outil de créativité immense pour les combos et la défense.

Contre-jeu : Deux placements nécessaires, marques visibles et distance maximale stricte."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_lngd2"]
script = ExtResource("7_tkkme")
weight = 4.0
exclusions = Array[StringName]([])
allowed_villages = Array[StringName]([])
rollable = true
id = &"sub_a_surcadencage_du_reseau_de_chakra"
display_name = "Surcadençage du réseau de chakra"
description = "Le joueur accélère son réseau de chakra pendant une courte durée."
source = 3
rank = 3
owner_id = &""
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"BUFF"])
design_tags = PackedStringArray("Cooldown manipulation", "Heat", "Risk")
details = "Le joueur accélère son réseau de chakra pendant une courte durée. Le prochain jutsu non ultime récupère une partie importante de son cooldown immédiatement après utilisation.

Mécanique : En échange, le joueur gagne Surchauffe : pendant quelques secondes, ses coûts en chakra augmentent et il ne peut pas réutiliser Surcadençage. Le même jutsu ne peut pas être reset deux fois de suite.

Synergies : Permet des combos exceptionnels sans devenir une réduction de cooldown permanente.

Contre-jeu : Fenêtre très lisible et dette de ressource importante ; utiliser le reset sur le mauvais sort est très punitif."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_20m2f"]
script = ExtResource("7_tkkme")
weight = 4.0
exclusions = Array[StringName]([])
allowed_villages = Array[StringName]([])
rollable = true
id = &"sub_a_marque_maudite_stade_i"
display_name = "Marque maudite — Stade I"
description = "Une marque se répand sur le corps."
source = 3
rank = 3
owner_id = &""
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"BUFF"])
design_tags = PackedStringArray("Mode", "Resource corruption", "Choice")
details = "Une marque se répand sur le corps. Le joueur gagne vitesse de mudra et puissance de chakra, mais chaque jutsu lancé remplit une jauge de Corruption.

Mécanique : À certains seuils, la Corruption réduit la récupération de chakra puis commence à infliger une faible perte de PV. Le joueur peut couper le mode quand il veut ; la Corruption descend lentement ensuite.

Synergies : Pic offensif modulable où le joueur choisit consciemment jusqu'où aller.

Contre-jeu : Aucune défense supplémentaire et risque croissant. Forcer le joueur à caster beaucoup accélère sa propre dette."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_7nxsc"]
script = ExtResource("7_tkkme")
weight = 4.0
exclusions = Array[StringName]([])
allowed_villages = Array[StringName]([])
rollable = true
id = &"sub_a_orbite_des_mille_senbon"
display_name = "Orbite des mille senbon"
description = "Des dizaines de senbon de chakra restent suspendus autour d'une zone en anneau."
source = 3
rank = 3
owner_id = &""
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"RANGED", &"PROJECTILE"])
design_tags = PackedStringArray("Persistent projectiles", "Trigger", "Anti-mobility")
details = "Des dizaines de senbon de chakra restent suspendus autour d'une zone en anneau. Ils ne tirent pas immédiatement.

Mécanique : Chaque dash ennemi à l'intérieur déclenche une petite salve depuis la portion d'anneau la plus proche. Le joueur peut réactiver pour tirer le reste vers le centre, mettant fin au piège.

Synergies : Punition conditionnelle de la mobilité, pas une pluie automatique.

Contre-jeu : Marcher normalement ne déclenche rien. L'anneau est visible et sa fermeture finale est télégraphiée."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_154wm"]
script = ExtResource("7_tkkme")
weight = 4.0
exclusions = Array[StringName]([])
allowed_villages = Array[StringName]([])
rollable = true
id = &"sub_a_sceau_de_suppression_majeure"
display_name = "Sceau de suppression majeure"
description = "Un grand talisman est projeté lentement."
source = 3
rank = 3
owner_id = &""
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"RANGED", &"PROJECTILE", &"DEBUFF"])
design_tags = PackedStringArray("Skillshot", "Chakra tax", "Reveal")
details = "Un grand talisman est projeté lentement. S'il colle à une cible, il augmente temporairement le coût de ses jutsu et affiche une pulsation avant chaque mudra.

Mécanique : La cible peut retirer le sceau en restant immobile une courte durée ou un allié peut le frapper pour l'arracher.

Synergies : Crée une fenêtre de pression sur les gros casters tout en offrant un contre-jeu actif.

Contre-jeu : Projectile lent, sceau retirable et aucun silence complet."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_5udj3"]
script = ExtResource("7_tkkme")
weight = 4.0
exclusions = Array[StringName]([])
allowed_villages = Array[StringName]([])
rollable = true
id = &"sub_a_invocation_faucon_de_relais"
display_name = "Invocation — Faucon de relais"
description = "Un faucon survole une zone choisie."
source = 3
rank = 3
owner_id = &""
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"BUFF", &"DEBUFF"])
design_tags = PackedStringArray("Summon", "Vision", "Mobility anchor")
details = "Un faucon survole une zone choisie. Il fournit une vue aérienne simplifiée sous forme de pings de mouvement et peut servir une seule fois de point d'ancrage pour un saut/dash du lanceur.

Mécanique : Après utilisation comme ancre, le faucon s'enfuit immédiatement. Tant qu'il reste en observation, il peut être abattu.

Synergies : Outil hybride reconnaissance/mobilité à forte valeur tactique.

Contre-jeu : Invocation visible, destructible et information volontairement imprécise : pas de wallhack permanent."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_gpe3f"]
script = ExtResource("7_tkkme")
weight = 4.0
exclusions = Array[StringName]([])
allowed_villages = Array[StringName]([])
rollable = true
id = &"sub_a_reservoir_de_chakra_scelle"
display_name = "Réservoir de chakra scellé"
description = "Le joueur canalise pour stocker une portion de son chakra actuel dans un sceau personnel."
source = 3
rank = 3
owner_id = &""
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"BUFF"])
design_tags = PackedStringArray("Stored resource", "Delayed payoff", "Risk")
details = "Le joueur canalise pour stocker une portion de son chakra actuel dans un sceau personnel. Tant que le sceau reste fermé, sa réserve maximale disponible est réduite d'autant.

Mécanique : À n'importe quel moment ultérieur du combat, il peut briser le sceau pour récupérer instantanément la quantité stockée et gagner une brève résistance aux interruptions de mudra.

Synergies : Permet de préparer un second souffle au prix d'être volontairement plus faible avant.

Contre-jeu : Canalisation initiale vulnérable et perte stratégique si le joueur meurt ou n'a jamais l'occasion d'ouvrir le sceau."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_icaby"]
script = ExtResource("7_tkkme")
weight = 4.0
exclusions = Array[StringName]([])
allowed_villages = Array[StringName]([])
rollable = true
id = &"sub_s_hiraishin_reseau_des_marques"
display_name = "Hiraishin — Réseau des marques"
description = "Le joueur peut poser jusqu'à quatre marques spatio-temporelles pendant une longue durée de combat."
source = 3
rank = 4
owner_id = &""
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"MOVEMENT", &"DASH"])
design_tags = PackedStringArray("Teleport network", "Setup", "Recast")
details = "Le joueur peut poser jusqu'à quatre marques spatio-temporelles pendant une longue durée de combat. L'activation de l'ultime ouvre une fenêtre durant laquelle il peut se téléporter successivement sur chaque marque une seule fois.

Mécanique : À chaque arrivée, il choisit son orientation et conserve son élan, mais ne bénéficie que d'une très courte invulnérabilité de matérialisation destinée à éviter le chevauchement. Les marques ne permettent pas de téléporter de force un ennemi.

Synergies : Un véritable S de préparation et de mouvement : plus les marques sont intelligentes, plus le parcours est puissant.

Contre-jeu : Les marques sont visibles aux joueurs proches, destructibles et chaque point n'est utilisable qu'une fois pendant la fenêtre."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_reoyj"]
script = ExtResource("7_tkkme")
weight = 4.0
exclusions = Array[StringName]([])
allowed_villages = Array[StringName]([])
rollable = true
id = &"sub_s_huit_portes_porte_de_la_vue"
display_name = "Huit Portes — Porte de la Vue"
description = "Le joueur ouvre une Porte supérieure et gagne un pic massif de vitesse physique, d'accélération et de résistance aux déplacements forcés."
source = 3
rank = 4
owner_id = &""
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"BUFF", &"HEAL"])
design_tags = PackedStringArray("Extreme mode", "Health debt", "Lockout")
details = "Le joueur ouvre une Porte supérieure et gagne un pic massif de vitesse physique, d'accélération et de résistance aux déplacements forcés. Ses coups créent des ondes d'air courtes.

Mécanique : La jauge de Porte se vide rapidement et chaque technique physique accélère le drain. À la fermeture, une Dette corporelle retire progressivement une portion importante de PV et désactive les dashes pendant un court moment.

Synergies : Ultime de all-in : extrêmement fort pendant quelques secondes, mais impossible à utiliser sans accepter une phase de vulnérabilité réelle.

Contre-jeu : Kite, terrain défensif et contrôles de zone restent efficaces. Aucun nettoyage de la Dette par soin instantané."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_204fp"]
script = ExtResource("7_tkkme")
weight = 4.0
exclusions = Array[StringName]([])
allowed_villages = Array[StringName]([])
rollable = true
id = &"sub_s_marque_maudite_stade_ii"
display_name = "Marque maudite — Stade II"
description = "Le joueur transforme complètement la Marque maudite."
source = 3
rank = 4
owner_id = &""
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"BUFF"])
design_tags = PackedStringArray("Transformation", "Mutations", "Corruption")
details = "Le joueur transforme complètement la Marque maudite. Il choisit au lancement deux mutations parmi trois : ailes de mobilité, carapace de garde, membres offensifs.

Mécanique : Chaque mutation donne une nouvelle propriété mais la Corruption augmente en continu. À saturation, le mode s'arrête brutalement et le joueur subit une période où son chakra maximal est temporairement réduit.

Synergies : Ultime personnalisable à chaque activation, permettant un build adapté à la situation.

Contre-jeu : Deux choix seulement, dette lourde et silhouettes des mutations immédiatement lisibles pour l'adversaire."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_xdfj5"]
script = ExtResource("7_tkkme")
weight = 4.0
exclusions = Array[StringName]([])
allowed_villages = Array[StringName]([])
rollable = true
id = &"sub_s_barriere_spatio_temporelle"
display_name = "Barrière spatio-temporelle"
description = "Un portail défensif large s'ouvre devant le joueur pendant une très courte durée."
source = 3
rank = 4
owner_id = &""
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"RANGED", &"PROJECTILE", &"CC"])
design_tags = PackedStringArray("Portal shield", "Capture projectile", "Recast")
details = "Un portail défensif large s'ouvre devant le joueur pendant une très courte durée. Les projectiles et techniques linéaires non ultimes qui y entrent sont retirés du terrain et stockés comme Masse spatiale.

Mécanique : Réactiver ouvre une sortie à un autre point proche et recrache cette Masse sous forme d'une onde neutre unique, dont taille et poussée dépendent de ce qui a été absorbé, avec dégâts plafonnés.

Synergies : Défense de timing pouvant convertir une salve ennemie en repositionnement offensif.

Contre-jeu : Orientation fixe, fenêtre courte, aucune absorption des mêlées, zones ou ultimes. Si rien n'est capté, l'ultime est largement gaspillé."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_tpvkh"]
script = ExtResource("7_tkkme")
weight = 4.0
exclusions = Array[StringName]([])
allowed_villages = Array[StringName]([])
rollable = true
id = &"sub_s_legion_des_clones_d_ombre"
display_name = "Légion des clones d'ombre"
description = "Le joueur crée un groupe important de clones fragiles."
source = 3
rank = 4
owner_id = &""
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"BUFF"])
design_tags = PackedStringArray("Multi-body", "Shared command", "Resource split")
details = "Le joueur crée un groupe important de clones fragiles. Au lieu d'avoir chacun une IA complète, ils reçoivent trois ordres successifs choisis par le joueur : charger un point, encercler une cible ou lancer une attaque basique synchronisée.

Mécanique : Chaque ordre consomme une part du chakra total investi. Les clones meurent rapidement mais forcent l'adversaire à lire la formation et les angles.

Synergies : Ultime stratégique d'espace et de surcharge visuelle, contrôlé par commandes plutôt que par auto-aim.

Contre-jeu : AOE puissantes et défense de zone nettoient très bien les clones. Le joueur partage une grosse partie de son chakra avec eux et reste vulnérable."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_eyh72"]
script = ExtResource("7_tkkme")
weight = 4.0
exclusions = Array[StringName]([])
allowed_villages = Array[StringName]([])
rollable = true
id = &"sub_s_sphere_spirale_effondrement"
display_name = "Sphère spirale — Effondrement"
description = "Le joueur forme une sphère de chakra instable en avançant lentement."
source = 3
rank = 4
owner_id = &""
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"RANGED", &"PROJECTILE", &"MOVEMENT", &"DASH", &"CC"])
design_tags = PackedStringArray("Charged melee projectile", "Knockback", "Recast")
details = "Le joueur forme une sphère de chakra instable en avançant lentement. Il peut soit frapper au corps à corps, soit réactiver pour la projeter sur une courte distance.

Mécanique : Au contact, la sphère n'explose pas immédiatement : elle aspire légèrement vers son centre pendant une fraction de seconde puis expulse violemment. La version lancée a moins de dégâts mais une zone plus large.

Synergies : Choix clair entre finisher rapproché et contrôle de zone à distance limitée.

Contre-jeu : Charge très visible, mobilité réduite, possibilité d'interrompre avant formation complète et portée de lancer volontairement courte."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_qgi67"]
script = ExtResource("7_tkkme")
weight = 4.0
exclusions = Array[StringName]([])
allowed_villages = Array[StringName]([])
rollable = true
id = &"sub_s_domaine_d_extinction_du_chakra"
display_name = "Domaine d'extinction du chakra"
description = "Une grande zone est scellée pendant quelques secondes."
source = 3
rank = 4
owner_id = &""
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"AOE"])
design_tags = PackedStringArray("Domaine", "Anti-cast", "Symmetric rule")
details = "Une grande zone est scellée pendant quelques secondes. À l'intérieur, chaque jutsu utilisé ajoute une charge d'Extinction au lanceur de ce jutsu. À 3 charges, son prochain jutsu est automatiquement retardé par un long mudra supplémentaire puis ses charges disparaissent.

Mécanique : La règle s'applique aussi au propriétaire du domaine. Les attaques physiques et outils restent inchangés.

Synergies : Ultime de contrôle du rythme qui punit le spam de sorts des deux côtés et favorise la planification.

Contre-jeu : Aucun silence immédiat, zone fixe et règle symétrique. Quitter le domaine retire progressivement les charges."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_fr480"]
script = ExtResource("7_tkkme")
weight = 4.0
exclusions = Array[StringName]([])
allowed_villages = Array[StringName]([])
rollable = true
id = &"sub_s_transfert_celeste_interdit"
display_name = "Transfert céleste interdit"
description = "Le joueur marque un point puis canalise sur un allié ou sur un ennemi déjà sous contrôle dur provenant d'une autre source."
source = 3
rank = 4
owner_id = &""
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"MOVEMENT", &"DASH"])
design_tags = PackedStringArray("Target reposition", "Ally rescue", "Enemy consent condition")
details = "Le joueur marque un point puis canalise sur un allié ou sur un ennemi déjà sous contrôle dur provenant d'une autre source. À la fin, la cible est transférée au point marqué.

Mécanique : Sur allié, la canalisation est plus courte et sert de sauvetage. Sur ennemi, le sort ne peut jamais initier seul un enlèvement : il exige une cible déjà immobilisée et laisse une longue alerte visuelle permettant à son équipe d'interrompre.

Synergies : S extrêmement tactique pour sauver un allié ou convertir un contrôle d'équipe en repositionnement décisif.

Contre-jeu : Longue canalisation, point de destination visible et impossibilité d'utiliser la version offensive sans setup externe."
requirements = Array[StringName]([])
passive = false
placeholder = false

