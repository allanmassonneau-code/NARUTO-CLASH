[sub_resource type="Resource" id="Resource_bl5os"]
script = ExtResource("2_3fpi1")
id = &"clan_hoshigaki_a_frenesie_des_branchies"
display_name = "Frénésie des branchies"
description = "Le Hoshigaki dépense toutes ses charges de Faim pour entrer en Frénésie."
source = 1
