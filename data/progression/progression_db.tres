[sub_resource type="Resource" id="Resource_7wikw"]
script = ExtResource("2_bdunr")
id = &"clan_karatachi_b_crocs_de_terre_du_seigneur_legendaire"
display_name = "Crocs de Terre du Seigneur Légendaire"
description = "Prenez le contrôle d'une créature ressemblant à un chien pour attaquer. Elle avancera en ligne droite en infligeant des dégâts à toutes les cibles touchées. Une fois lancée, la créature deviendra un terrain capable de se déplacer et d'appliquer des effets aux alliés et aux ennemis. Quand un allié (ou l'utilisateur) s'approche du terrain, sa vitesse de déplacement sera augmentée, alors que si des ennemis s'en approchent, il explosera et leur infligera des dégâts. Appuyez et maintenez la touche de Ninjutsu pour choisir dans quelle direction la créature partira."
