[sub_resource type="Resource" id="Resource_jwxpd"]
script = ExtResource("2_3fpi1")
id = &"raiton_c_arc_sauteur"
display_name = "Arc sauteur"
description = "Un éclair frappe une cible ou un point chargé puis cherche jusqu'à deux nouvelles cibles proches."
