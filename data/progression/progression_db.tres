[sub_resource type="Resource" id="Resource_l5vpp"]
script = ExtResource("2_3fpi1")
id = &"clan_roran_c_trois_souffles_cadences"
display_name = "Trois souffles cadencés"
description = "Le Roran effectue jusqu'à trois balayages."
source = 1
rank = 1
owner_id = &"clan_roran"
chakra_cost = 20.0
cooldown = 10.0
tags = Array[StringName]([&"BUFF"])
design_tags = PackedStringArray("Séquence", "Choix de rythme", "Recast")
details = "Le Roran effectue jusqu'à trois balayages. Le premier est large et faible, le second plus étroit, le troisième très fin et puissant. Le joueur choisit le tempo entre les coups avec le recast.

Mécanique : Dépenser 1 Battement sur un coup le rend instantanément disponible et modifie sa fonction : large = plus de push, moyen = ralentissement bref, fin = petite perforation de garde.

Synergies : Le joueur peut s'arrêter après un ou deux souffles pour garder du tempo, ou engager toute la séquence pour une vraie menace.

Contre-jeu : Chaque souffle est télégraphié et la séquence peut être interrompue. Brûler ses Battements trop tôt rend la fin prévisible."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_ilny3"]
script = ExtResource("2_3fpi1")
id = &"clan_roran_b_eventail_miroir"
display_name = "Éventail miroir"
description = "Le Roran ouvre complètement son éventail pendant une très courte fenêtre."
source = 1
rank = 2
owner_id = &"clan_roran"
chakra_cost = 28.0
cooldown = 14.0
tags = Array[StringName]([&"COUNTER"])
design_tags = PackedStringArray("Contre directionnel", "Redirection", "Ressource")
details = "Le Roran ouvre complètement son éventail pendant une très courte fenêtre. Un projectile compatible ou une poussée frontale reçue est capté comme Direction.

Mécanique : Le prochain mouvement Roran peut consommer cette Direction pour ajouter le vecteur capturé à son propre effet : un push reçu de gauche peut ainsi transformer un souffle en diagonale, un projectile capté peut être relancé comme rafale neutre.

Synergies : Mécanique de redirection réellement différente du simple bouclier ; elle récompense l'anticipation et l'angle.

Contre-jeu : Une seule Direction stockée, durée courte, aucun effet contre mêlée lourde ou zone. Le joueur doit ensuite réussir à exploiter le vecteur."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_t53tm"]
