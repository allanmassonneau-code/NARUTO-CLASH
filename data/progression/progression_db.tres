[sub_resource type="Resource" id="Resource_gou5b"]
script = ExtResource("1_2nrr7")
id = &"clan_hakumei"
display_name = "Hakumei"
village_id = &"suna"
description = "Lumière de l'aube et illusions solaires."
identity = "Hakumei est un clan d'assassinat et d'illusion. Son pouvoir central, le Doute, ne retire jamais le contrôle au joueur adverse : il introduit de fausses informations crédibles — silhouettes, sons, marqueurs — que le Hakumei exploite pour frapper depuis l'angle inattendu."
signature = "Doute : certaines techniques placent des charges de Doute sur une cible, maximum 3. Chaque charge permet au Hakumei de créer une illusion plus convaincante ou d'améliorer une attaque venant hors du champ de vision. Les charges sont perdues si la cible frappe correctement le vrai Hakumei ou reste longtemps hors combat."
jutsu = Array[ExtResource("2_3fpi1")]([SubResource("Resource_oxf16"), SubResource("Resource_iu6lg"), SubResource("Resource_14fbr"), SubResource("Resource_osbvi"), SubResource("Resource_cbyox")])
placeholder = false

[sub_resource type="Resource" id="Resource_8af61"]
script = ExtResource("2_3fpi1")
id = &"clan_chinoike_d_aiguille_carmine"
display_name = "Aiguille carmine"
description = "Le Chinoike crée une aiguille de sang condensé et la lance rapidement."
source = 1
rank = 0
owner_id = &"clan_chinoike"
chakra_cost = 12.0
cooldown = 6.0
tags = Array[StringName]([&"RANGED", &"PROJECTILE", &"DOT"])
design_tags = PackedStringArray("Projectile", "Hémorragie", "Ressource")
details = "Le Chinoike crée une aiguille de sang condensé et la lance rapidement. Elle inflige peu de dégâts, applique une courte Hémorragie et 1 Goutte de dette.

Mécanique : Maintenir légèrement le cast prélève un peu de vie au lanceur pour rendre l'aiguille perforante sur une seconde cible.

Synergies : Outil de setup permettant de commencer la Dette sans dépendre d'une blessure préalable.

Contre-jeu : Hitbox fine et coût personnel de la variante perforante. Une cible peut purger l'Hémorragie ou simplement attendre son expiration."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_6ulfl"]
script = ExtResource("2_3fpi1")
id = &"clan_chinoike_c_miroir_hematique"
display_name = "Miroir hématique"
description = "Le lanceur crée une plaque de sang réfléchissante devant lui."
source = 1
rank = 1
owner_id = &"clan_chinoike"
chakra_cost = 20.0
cooldown = 10.0
tags = Array[StringName]([&"COUNTER", &"BUFF"])
design_tags = PackedStringArray("Clone réactif", "Contre", "Information")
details = "Le lanceur crée une plaque de sang réfléchissante devant lui. La première attaque directe compatible qui la touche imprime une silhouette de l'attaquant dans le miroir.

Mécanique : Le Chinoike peut réactiver pour faire surgir la silhouette et reproduire uniquement le déplacement initial de l'attaque sous forme d'un dash fantôme qui applique 1 Goutte de dette s'il traverse son auteur.

Synergies : Ce n'est pas une copie de dégâts : c'est un outil de contre-position et de lecture.

Contre-jeu : Fenêtre courte, miroir directionnel et destructible. Les AOE ou attaques par derrière l'ignorent."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_knrey"]
script = ExtResource("2_3fpi1")
id = &"clan_chinoike_b_marionnette_ecarlate"
display_name = "Marionnette écarlate"
description = "Sur une cible possédant au moins 2 Gouttes, le Chinoike crée un fil de sang entre elle et lui."
source = 1
rank = 2
owner_id = &"clan_chinoike"
chakra_cost = 28.0
cooldown = 14.0
tags = Array[StringName]([&"CC"])
design_tags = PackedStringArray("Tether", "Mouvement forcé conditionnel", "Ressource")
details = "Sur une cible possédant au moins 2 Gouttes, le Chinoike crée un fil de sang entre elle et lui. Pendant quelques secondes, chaque gros changement de direction du lanceur tire légèrement la cible dans le même sens.

Mécanique : Consommer la troisième Goutte permet une seule impulsion plus forte, après quoi le lien se rompt. La cible garde toutes ses attaques et peut casser la portée.

Synergies : Contrôle subtil qui devient fort si le Chinoike sait bouger et combiner avec le terrain.

Contre-jeu : Nécessite préparation, ligne visible et portée limitée. Les dashes permettent souvent de rompre le lien."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_78rag"]
script = ExtResource("2_3fpi1")
id = &"clan_chinoike_a_ketsuryugan_regard_de_coagulation"
display_name = "Ketsuryûgan — Regard de coagulation"
description = "Le Chinoike fixe une cible pendant une courte canalisation."
source = 1
rank = 3
owner_id = &"clan_chinoike"
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"BUFF", &"DEBUFF"])
design_tags = PackedStringArray("Focus", "Debuff adaptatif", "Vision")
details = "Le Chinoike fixe une cible pendant une courte canalisation. S'il maintient le regard, il transforme ses Gouttes en Coagulation : la cible voit ses prochaines dépenses de chakra laisser une trace rouge visible et accumule un ralentissement léger de récupération de chakra.

Mécanique : À 3 Gouttes consommées, le prochain gros jutsu de la cible crée brièvement un point faible hématique visible que le Chinoike peut frapper pour interrompre sa récupération, pas le cast déjà lancé.

Synergies : Crée un duel de ressources et d'information plutôt qu'un genjutsu de contrôle gratuit.

Contre-jeu : Canalisation cassée par la ligne de vue ; l'effet disparaît avec le temps et ne bloque jamais l'utilisation des techniques."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_doy2t"]
script = ExtResource("2_3fpi1")
id = &"clan_chinoike_s_palais_de_sang"
display_name = "Palais de sang"
description = "Une grande zone devient un réseau de filaments rouges."
source = 1
rank = 4
owner_id = &"clan_chinoike"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"AOE", &"MELEE"])
design_tags = PackedStringArray("Domaine", "Ressource partagée", "Finisher")
details = "Une grande zone devient un réseau de filaments rouges. Tout personnage qui perd une quantité significative de PV dans le domaine laisse une Flaque de sang neutre. Le Chinoike peut attirer une Flaque vers lui ou vers une cible marquée.

Mécanique : Réactiver consomme toutes les Flaques proches pour créer des pointes depuis leurs positions. Les dégâts dépendent surtout du nombre d'angles couverts ; une même cible possède un plafond de hits strict.

Synergies : Ultime qui transforme le combat entier en ressource et récompense la préparation de plusieurs blessures.

Contre-jeu : Le domaine n'inflige presque rien sans combat actif. Les Flaques sont visibles et peuvent être évitées ; le Chinoike doit rester dans la zone pour les commander."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_r38ro"]
script = ExtResource("1_2nrr7")
id = &"clan_chinoike"
display_name = "Chinoike"
village_id = &"ame"
description = "Ketsuryūgan et sang."
identity = "Le clan Chinoike transforme le sang en information, en arme et en dette. Son gameplay repose sur l'état Hémorragie et sur des Liens sanguins temporaires. Il excelle à punir une cible déjà blessée, mais doit d'abord créer cette condition et s'expose lorsqu'il utilise son propre sang."
signature = "Dette de sang : infliger ou subir certains dégâts applique des Gouttes de dette, maximum 3 par cible. Les techniques Chinoike peuvent les consommer pour augmenter leur contrôle ou créer un lien. Certaines variantes coûtent une petite portion de PV au lanceur, jamais létale à elles seules."
jutsu = Array[ExtResource("2_3fpi1")]([SubResource("Resource_8af61"), SubResource("Resource_6ulfl"), SubResource("Resource_knrey"), SubResource("Resource_78rag"), SubResource("Resource_doy2t")])
placeholder = false

[sub_resource type="Resource" id="Resource_0k8uw"]
script = ExtResource("2_3fpi1")
id = &"clan_fuma_d_shuriken_fuma_angle_mort"
display_name = "Shuriken Fûma — Angle mort"
description = "Un grand shuriken est lancé horizontalement."
source = 1
rank = 0
