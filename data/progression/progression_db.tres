chakra_cost = 28.0
cooldown = 14.0
tags = Array[StringName]([&"AOE"])
design_tags = PackedStringArray("Deux ancres", "Zone linéaire", "Pulses")
details = "Le joueur place un premier totem de pierre puis un second. Une ligne sismique existe entre les deux et pulse à intervalles fixes.

Mécanique : Les ennemis sur la ligne au moment d'un pulse subissent un choc et une très courte perte d'équilibre. Une Strate ou un mur traversé par la ligne amplifie un pulse puis se Fissure.

Synergies : Permet de construire une zone de contrôle qui dépend réellement du placement de deux points et du terrain créé.

Contre-jeu : Détruire un totem supprime la chambre. Entre deux pulses, la ligne n'empêche pas le passage."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_nvcno"]
script = ExtResource("2_3fpi1")
id = &"doton_a_faille_ascendante"
display_name = "Faille ascendante"
description = "Une fissure se propage au sol en segments successifs."
source = 0
rank = 3
owner_id = &"doton"
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"RANGED", &"HITSCAN", &"AOE", &"LAUNCH", &"CC"])
design_tags = PackedStringArray("Ligne séquencée", "Launcher", "Terrain")
details = "Une fissure se propage au sol en segments successifs. Chaque segment explose vers le haut après un délai légèrement différent, créant une vague de piliers plutôt qu'une seule ligne instantanée.

Mécanique : Le joueur peut réactiver une fois pour stopper la propagation au segment actuel et faire éclater immédiatement les segments restants déjà armés.

Synergies : Permet de couper une retraite, jongler une cible mal placée ou créer plusieurs Strates cassées pour les techniques futures.

Contre-jeu : La séquence est lisible et un joueur peut courir perpendiculairement à la ligne. Le recast raccourcit la portée totale."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_qp7e2"]
script = ExtResource("2_3fpi1")
id = &"doton_a_colosse_de_basalte"
display_name = "Colosse de basalte"
description = "Un golem massif surgit du sol et reste attaché à une petite zone."
source = 0
rank = 3
owner_id = &"doton"
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"BUFF"])
design_tags = PackedStringArray("Invocation", "Copie d\'action", "Tank")
details = "Un golem massif surgit du sol et reste attaché à une petite zone. Il reproduit avec un léger délai la direction des attaques de base du lanceur sous forme de grands coups de pierre.

Mécanique : Le golem possède ses propres PV. S'il meurt, il s'effondre en plusieurs Fragments utilisables par Armure lithique. Il ne poursuit pas les ennemis hors de sa zone.

Synergies : Fait du Doton un combattant de position : le joueur cherche à placer le duel dans la zone du golem et à synchroniser ses frappes.

Contre-jeu : Très prévisible, immobile et destructible. Un adversaire peut simplement forcer le combat ailleurs."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_glu0t"]
script = ExtResource("2_3fpi1")
id = &"doton_s_citadelle_mobile"
display_name = "Citadelle mobile"
description = "Quatre grandes plaques surgissent autour d'une zone, créant une fortification ouverte."
source = 0
rank = 4
owner_id = &"doton"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"AOE"])
design_tags = PackedStringArray("Fortification", "Terrain majeur", "Reconfiguration")
details = "Quatre grandes plaques surgissent autour d'une zone, créant une fortification ouverte. Le joueur peut, à intervalles espacés, faire coulisser une plaque pour ouvrir ou fermer un angle.

Mécanique : Les plaques possèdent des PV et deviennent des Strates. Elles ne peuvent jamais former une prison totalement hermétique : au moins une sortie reste ouverte.

Synergies : Ultime stratégique pour remodeler un point de combat, protéger une résurrection, casser des lignes de tir ou canaliser une équipe adverse.

Contre-jeu : Très peu de dégâts directs. Les structures peuvent être détruites, et les combattants mobiles peuvent utiliser les ouvertures."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_tlulc"]
script = ExtResource("2_3fpi1")
id = &"doton_s_cur_tellurique"
display_name = "Cœur tellurique"
description = "Le lanceur plante un Cœur de pierre."
source = 0
rank = 4
owner_id = &"doton"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"AOE"])
design_tags = PackedStringArray("Noyau", "Stockage d\'impact", "Détonation")
details = "Le lanceur plante un Cœur de pierre. Tous les impacts lourds, effondrements de structures et Fissures dans la zone chargent progressivement le noyau, qu'ils viennent d'alliés ou d'ennemis.

Mécanique : Le joueur peut réactiver pour libérer l'énergie en plusieurs anneaux sismiques successifs. La puissance vient du nombre d'événements stockés, mais les dégâts sont plafonnés ; les charges supplémentaires augmentent surtout le rayon et le nombre d'anneaux.

Synergies : Transforme un combat chaotique autour de structures en ressource. Le Doton peut volontairement sacrifier ses propres murs pour le charger.

Contre-jeu : Le noyau est visible, destructible et ne se charge presque pas si l'équipe refuse de combattre autour. Une destruction ennemie provoque une petite décharge neutre au lieu de l'ultime complet."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_7w6vr"]
script = ExtResource("4_xgouj")
id = &"doton"
display_name = "Doton"
description = "Terre : défense, murs et lourds impacts."
identity = "Doton manipule le terrain et l'inertie. Son joueur crée des structures, des lignes de faille et des fragments de roche qui modifient la carte. Ce n'est pas seulement une nature défensive : elle gagne les combats en fabriquant des angles, des obstacles et des zones de vibration."
signature = "Strates / Fissures : plusieurs techniques créent des Strates de terrain temporaire. Les impacts lourds peuvent Fissurer ces Strates ; une technique ultérieure peut alors les faire éclater ou s'en servir comme point d'origine. Les structures ont des PV distincts et restent destructibles."
color = Color(0.658824, 0.501961, 0.301961, 1)
jutsu = Array[ExtResource("2_3fpi1")]([SubResource("Resource_i4oay"), SubResource("Resource_usj2g"), SubResource("Resource_ebcob"), SubResource("Resource_0myf8"), SubResource("Resource_di1je"), SubResource("Resource_owsnu"), SubResource("Resource_nvcno"), SubResource("Resource_qp7e2"), SubResource("Resource_glu0t"), SubResource("Resource_tlulc")])
placeholder = false

[sub_resource type="Resource" id="Resource_kb74b"]
script = ExtResource("2_3fpi1")
id = &"futon_d_lame_de_sillage"
display_name = "Lame de sillage"
description = "Une lame de vent part en ligne puis revient automatiquement au lanceur après une courte distance."
source = 0
rank = 0
owner_id = &"futon"
chakra_cost = 12.0
cooldown = 6.0
tags = Array[StringName]([&"RANGED", &"PROJECTILE", &"HITSCAN"])
design_tags = PackedStringArray("Boomerang", "Skillshot", "Double ligne")
details = "Une lame de vent part en ligne puis revient automatiquement au lanceur après une courte distance. L'aller et le retour peuvent toucher séparément la même cible, mais le second impact inflige moins de dégâts.

Mécanique : Le joueur peut se déplacer pendant le retour : modifier sa position modifie donc l'angle de la deuxième ligne.

Synergies : Très simple à comprendre mais riche : l'objectif est souvent de rater légèrement l'aller pour créer un retour difficile à lire.

Contre-jeu : Projectile fin et trajectoire initiale évidente. Un adversaire qui suit le déplacement du lanceur peut prédire le retour."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_54wpe"]
script = ExtResource("2_3fpi1")
id = &"futon_d_paume_de_pression"
display_name = "Paume de pression"
description = "Une paume libère un cône de pression."
source = 0
rank = 0
owner_id = &"futon"
chakra_cost = 12.0
cooldown = 6.0
tags = Array[StringName]([&"AOE", &"CC"])
design_tags = PackedStringArray("Cône", "Push/Pull", "Contrôle directionnel")
details = "Une paume libère un cône de pression. Maintenir avant de relâcher inverse l'effet : clic rapide repousse, maintien court aspire légèrement.

Mécanique : Les dégâts sont minimes ; la valeur vient du déplacement. Une cible contre un obstacle subit une micro-perte d'équilibre mais pas de stun long.

Synergies : Permet de repositionner pour Lame de sillage, sortir quelqu'un d'un couvert ou ramener une cible dans une coupe.

Contre-jeu : Portée courte et animation différente entre poussée et aspiration, donc lisible pour un joueur attentif."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_xjf84"]
script = ExtResource("2_3fpi1")
id = &"futon_c_fil_du_vide"
display_name = "Fil du vide"
description = "Le joueur trace une ligne très fine dans l'air."
source = 0
rank = 1
owner_id = &"futon"
chakra_cost = 20.0
cooldown = 10.0
tags = Array[StringName]([&"RANGED", &"PROJECTILE", &"DEFENSIVE", &"AOE"])
design_tags = PackedStringArray("Skillshot retardé", "Coupe", "Anti-projectile")
details = "Le joueur trace une ligne très fine dans l'air. Après un bref délai, la ligne se contracte et coupe tout ce qui la traverse.

Mécanique : Au moment exact de la contraction, les petits projectiles qui croisent la ligne sont détruits. Le centre de la ligne constitue une zone de précision qui inflige davantage de dégâts aux ennemis.

Synergies : Outil de prédiction et de défense active. Paume de pression peut forcer quelqu'un à retraverser la ligne au bon moment.

Contre-jeu : La ligne est visible avant fermeture. Un adversaire patient peut attendre la contraction puis passer."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_43g4f"]
script = ExtResource("2_3fpi1")
id = &"futon_c_ascendance"
display_name = "Ascendance"
description = "Une colonne ascendante apparaît au point ciblé."
source = 0
rank = 1
owner_id = &"futon"
chakra_cost = 20.0
cooldown = 10.0
tags = Array[StringName]([&"AOE", &"MOVEMENT", &"DASH"])
design_tags = PackedStringArray("Colonne d\'air", "Mobilité verticale", "Terrain")
details = "Une colonne ascendante apparaît au point ciblé. Les personnages qui entrent sont soulevés progressivement, mais conservent leur contrôle horizontal.

Mécanique : Le Fûton peut utiliser la colonne pour gagner un tir plongeant ; un ennemi peut aussi l'exploiter, ce qui en fait un outil neutre bien placé. Les projectiles verticaux sont légèrement accélérés dans le courant.

Synergies : Crée une vraie dimension verticale et des opportunités d'angle pour Lame de sillage et Fil du vide.

Contre-jeu : La colonne ne piège personne et peut aider l'ennemi si elle est mal placée. Zone fixe et durée courte."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_de1ae"]
script = ExtResource("2_3fpi1")
id = &"futon_b_orbite_tranchante"
display_name = "Orbite tranchante"
description = "Un anneau de vent tourne autour du lanceur."
source = 0
rank = 2
owner_id = &"futon"
chakra_cost = 28.0
cooldown = 14.0
tags = Array[StringName]([&"RANGED", &"PROJECTILE", &"MELEE", &"DEFENSIVE"])
design_tags = PackedStringArray("Aura directionnelle", "Anti-projectile", "Mêlée")
details = "Un anneau de vent tourne autour du lanceur. Les petits projectiles qui entrent dans l'anneau sont déviés tangentiellement plutôt qu'annulés.

Mécanique : Les ennemis au corps à corps sont frappés par de petites coupes répétées, mais l'anneau possède une ouverture mobile derrière le lanceur ; il faut orienter son personnage pour défendre le bon côté.

Synergies : Défense active qui dépend du facing. Peut renvoyer indirectement un projectile vers un autre adversaire ou dégager un passage.

Contre-jeu : Ouverture arrière exploitable, durée limitée et inefficace contre rayons, grosses AOE et attaques de mêlée lourdes."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_12k52"]
script = ExtResource("2_3fpi1")
id = &"futon_b_tornade_de_prise"
display_name = "Tornade de prise"
description = "Une petite tornade avance lentement dans la direction visée."
source = 0
rank = 2
owner_id = &"futon"
chakra_cost = 28.0
cooldown = 14.0
tags = Array[StringName]([&"RANGED", &"PROJECTILE", &"CC"])
design_tags = PackedStringArray("Vortex mobile", "Pull", "Projectile manipulation")
details = "Une petite tornade avance lentement dans la direction visée. Elle aspire légèrement les personnages proches et capture les petits projectiles qu'elle croise.

Mécanique : À sa fin ou sur recast, les projectiles capturés sont relâchés en spirale autour du point de disparition, sans changer de propriétaire.

Synergies : Crée un objet mobile dangereux dont tout le monde doit tenir compte. Peut détourner une salve ennemie puis la relâcher ailleurs.

Contre-jeu : Très lente, visible et ses projectiles capturés peuvent devenir dangereux pour le lanceur lui-même. Les gros projectiles ne sont pas capturés."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_8co0b"]
script = ExtResource("2_3fpi1")
id = &"futon_a_pas_du_faucon"
display_name = "Pas du faucon"
description = "Le lanceur effectue une impulsion diagonale dans les airs."
source = 0
rank = 3
owner_id = &"futon"
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"MOVEMENT", &"DASH"])
design_tags = PackedStringArray("Mobilité aérienne", "Recast", "Assaut")
details = "Le lanceur effectue une impulsion diagonale dans les airs. Tant qu'il n'a pas touché le sol, un recast permet une seconde impulsion perpendiculaire à la première.

Mécanique : La première attaque offensive après la seconde impulsion gagne une petite poussée directionnelle et crée un Courant derrière le Fûton.

Synergies : Outil de flanc tridimensionnel qui récompense le contrôle aérien et la création d'angles.

Contre-jeu : Aucune invulnérabilité et trajectoires visibles. Si le joueur est interrompu en l'air, le recast disparaît."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_cdrm2"]
script = ExtResource("2_3fpi1")
id = &"futon_a_chambre_a_vide"
display_name = "Chambre à vide"
description = "Une sphère de basse pression apparaît."
source = 0
rank = 3
owner_id = &"futon"
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"RANGED", &"PROJECTILE", &"AOE", &"DEFENSIVE"])
design_tags = PackedStringArray("Zone", "Anti-projectile", "Gestion de souffle")
details = "Une sphère de basse pression apparaît. Les projectiles qui y entrent ralentissent fortement ; les sauts et impulsions aériennes y perdent de la hauteur.

Mécanique : Les personnages peuvent combattre normalement au sol, mais les longues canalisations respiratoires ou souffles continus sont écourtés. Le Fûton n'est pas immunisé à ses propres contraintes, il les maîtrise simplement mieux grâce à ses Courants.

Synergies : Excellent outil de contrôle contre les compositions projectile et de préparation pour Fil du vide.

Contre-jeu : Zone fixe, aucun hard-CC et dégâts quasi nuls. Les combattants de mêlée au sol peuvent l'ignorer en grande partie."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_qik7r"]
script = ExtResource("2_3fpi1")
id = &"futon_s_typhon_des_huit_directions"
display_name = "Typhon des huit directions"
description = "Huit points de vent apparaissent autour d'une grande zone."
source = 0
rank = 4
owner_id = &"futon"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"AOE", &"CC"])
design_tags = PackedStringArray("Domaine vectoriel", "Recast", "Contrôle")
details = "Huit points de vent apparaissent autour d'une grande zone. À chaque impulsion, quatre d'entre eux soufflent vers le centre et quatre vers l'extérieur.

Mécanique : Le lanceur peut réactiver pour faire tourner le motif de 45 degrés, changeant instantanément les corridors sûrs. Les personnages ne sont jamais hard-stun : ils doivent corriger leur trajectoire.

Synergies : Ultime de contrôle spatial très skillé, qui transforme les déplacements et peut aligner plusieurs ennemis pour une coupe.

Contre-jeu : Motifs visibles au sol et rythme constant. Un joueur calme peut apprendre le cycle et se placer entre les flux."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_bfvpn"]
script = ExtResource("2_3fpi1")
id = &"futon_s_lame_atmospherique"
display_name = "Lame atmosphérique"
description = "Le lanceur condense une immense lame invisible révélée par une distorsion de l'air."
source = 0
rank = 4
owner_id = &"futon"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"AOE"])
design_tags = PackedStringArray("Grande coupe", "Télégraphe", "Corridor")
details = "Le lanceur condense une immense lame invisible révélée par une distorsion de l'air. Après une longue préparation, elle traverse la carte en ligne droite sur une grande distance.

Mécanique : Après le passage, un Corridor de basse pression reste brièvement : tous les déplacements dans le sens de la lame sont accélérés, ceux à contre-sens ralentis. Le sort crée donc une conséquence tactique même s'il manque.

Synergies : Peut servir de finisher, ouvrir une route d'engage ou couper une retraite. Les autres techniques Fûton exploitent ensuite le corridor.

Contre-jeu : Télégraphe très long, direction verrouillée tôt et possibilité claire de sortir de l'axe. Le burst ne doit jamais être garanti par un simple lock-on."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_mee5d"]
script = ExtResource("4_xgouj")
id = &"futon"
display_name = "Futon"
description = "Vent : portée, coupures et repoussements."
identity = "Fûton est la nature des vecteurs et de la géométrie. Ses dégâts viennent de coupes très lisibles, mais sa vraie force est de modifier les trajectoires : pousser, aspirer, courber des projectiles et fabriquer des couloirs de vitesse. C'est une nature de spacing et de précision."
signature = "Courants : plusieurs techniques créent brièvement un Courant orienté. Les projectiles et personnages qui le traversent voient leur trajectoire influencée. Le Fûton gagne à réfléchir en lignes et en angles plutôt qu'en zones statiques."
