details = "Le joueur lance trois shuriken de papier en léger éventail. Ceux qui manquent se plantent dans le décor sous forme de Feuilles récupérables.

Mécanique : Maintenir le cast marque le projectile central comme Explosif au prix de ressource ; il n'explose pas encore, mais devient une future balise.

Synergies : Permet de poke tout en semant le terrain.

Contre-jeu : Dégâts individuels faibles, projectiles fragiles et ressource perdue tant que les feuilles restent loin."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_do5ei"]
script = ExtResource("2_3fpi1")
id = &"clan_kami_c_clone_origami"
display_name = "Clone origami"
description = "Un clone de papier part dans la direction choisie et imite une course simple."
source = 1
rank = 1
owner_id = &"clan_kami"
chakra_cost = 20.0
cooldown = 10.0
tags = Array[StringName]([&"AOE", &"BUFF"])
design_tags = PackedStringArray("Decoy", "Trap", "Recast")
details = "Un clone de papier part dans la direction choisie et imite une course simple. Au premier impact il se désagrège en Feuilles.

Mécanique : Réactiver le transforme volontairement en nuage de feuilles qui bloque brièvement la vision locale. Si le clone contient une Feuille Explosive, la dispersion provoque aussi un petit knockback.

Synergies : Utilisable comme leurre, écran visuel ou transport d'une balise explosive.

Contre-jeu : Le clone ne peut pas attaquer et ses mouvements sont plus rigides qu'un vrai joueur. Les dégâts de zone le dissipent facilement."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_85x50"]
script = ExtResource("2_3fpi1")
id = &"clan_kami_b_ailes_du_papier"
display_name = "Ailes du papier"
description = "Des ailes se forment et permettent une élévation contrôlée pendant quelques secondes."
source = 1
rank = 2
owner_id = &"clan_kami"
chakra_cost = 28.0
cooldown = 14.0
tags = Array[StringName]([&"AOE"])
design_tags = PackedStringArray("Vol limité", "Ressource continue", "Pluie")
details = "Des ailes se forment et permettent une élévation contrôlée pendant quelques secondes. La réserve de Feuilles se vide progressivement.

Mécanique : Pendant le vol, les attaques de base peuvent détacher des Feuilles vers le sol. Réactiver replie les ailes en chute rapide et rappelle une partie des feuilles directement sous le joueur.

Synergies : Mobilité verticale qui nourrit le futur contrôle de terrain, mais possède un vrai coût économique.

Contre-jeu : Silhouette très visible, pas d'invulnérabilité et vulnérabilité aux tirs précis. La réserve peut s'épuiser rapidement."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_kjdye"]
script = ExtResource("2_3fpi1")
id = &"clan_kami_a_cage_de_mille_feuillets"
display_name = "Cage de mille feuillets"
description = "Des bandes de papier tournent autour d'une zone en formant une cage poreuse."
source = 1
rank = 3
owner_id = &"clan_kami"
chakra_cost = 40.0
cooldown = 20.0
tags = Array[StringName]([&"AOE", &"DEFENSIVE"])
design_tags = PackedStringArray("Zone", "Barrière poreuse", "Détonateurs")
details = "Des bandes de papier tournent autour d'une zone en formant une cage poreuse. Les personnages peuvent sortir, mais traverser une paroi colle plusieurs Feuilles sur eux.

Mécanique : Les Feuilles collées ne font rien seules. Le joueur peut réactiver une fois pour faire exploser uniquement celles marquées Explosives, tandis que les autres deviennent des balises visibles pendant quelques secondes.

Synergies : Contrôle par menace et préparation plutôt qu'emprisonnement physique.

Contre-jeu : Traverser est toujours possible ; la cage coûte beaucoup de ressource et les explosions sont faibles si le joueur n'a pas préparé de papier explosif."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_yyhj4"]
script = ExtResource("2_3fpi1")
id = &"clan_kami_s_ocean_de_papier_mille_detonations"
display_name = "Océan de papier — Mille détonations"
description = "Le sol d'une grande zone se couvre de bandes de papier issues de toute la réserve restante."
source = 1
rank = 4
owner_id = &"clan_kami"
chakra_cost = 70.0
cooldown = 32.0
tags = Array[StringName]([&"AOE", &"CC"])
design_tags = PackedStringArray("Domaine", "Ressource totale", "Chaîne programmable")
details = "Le sol d'une grande zone se couvre de bandes de papier issues de toute la réserve restante. Le joueur trace jusqu'à trois chemins de détonation avec son viseur ; les explosions parcourent ensuite ces chemins dans l'ordre choisi.

Mécanique : Chaque chemin est annoncé une fraction de seconde avant d'exploser. Les Feuilles Explosives déjà placées sur le terrain s'ajoutent comme embranchements.

Synergies : Ultime de planification : le joueur dessine littéralement le pattern de danger et peut utiliser tout ce qu'il a semé auparavant.

Contre-jeu : Après l'ultime, la réserve est presque vide. Les chemins sont visibles et n'explosent pas simultanément, laissant des routes d'esquive."
requirements = Array[StringName]([])
passive = false
placeholder = false

[sub_resource type="Resource" id="Resource_wbrs6"]
script = ExtResource("1_2nrr7")
id = &"clan_kami"
display_name = "Kami"
village_id = &"ame"
description = "Origami de chakra."
identity = "Le clan Kami manipule des feuilles de papier-chakra comme un essaim programmable. Le kit repose sur le nombre de Feuilles disponibles, leur position et la possibilité de transformer le même papier en projectile, clone, aile, cage ou explosif."
signature = "Feuilles : une réserve abstraite se recharge lentement. Certaines techniques détachent des paquets de Feuilles sur le terrain ; les rappeler restaure plus vite la ressource. Les Feuilles peuvent être marquées comme Explosives, mais seules certaines techniques déclenchent cette propriété."
jutsu = Array[ExtResource("2_3fpi1")]([SubResource("Resource_blayv"), SubResource("Resource_do5ei"), SubResource("Resource_85x50"), SubResource("Resource_kjdye"), SubResource("Resource_yyhj4")])
